<?xml version="1.0" encoding="utf-8"?>
<!--
  Bản mẫu cho secrets.config (file thật KHÔNG commit lên git).
  Copy file này thành secrets.config rồi điền giá trị thật.
  Được nạp vào Web.config qua: <appSettings file="secrets.config">
  Các key ở đây sẽ GHI ĐÈ key cùng tên trong Web.config.
-->
<appSettings>
  <add key="vnp_HashSecret" value="YOUR_VNPAY_HASH_SECRET" />
  <add key="Brevo_ApiKey" value="YOUR_BREVO_API_KEY" />
  <add key="Brevo_FromEmail" value="YOUR_VERIFIED_SENDER_EMAIL" />
  <add key="vnp_Returnurl" value="https://your-domain.com/Cart/VnpayReturn" />

  <!-- Bỏ comment để bật lại thanh toán trực tuyến (mặc định chỉ COD) -->
  <!--<add key="EnableOnlinePayment" value="true" />-->
</appSettings>
