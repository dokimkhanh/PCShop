@model PCShop.Models.EF.Category
@{
    ViewBag.Title = "Cập nhật danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between">
            <h1>Sửa danh mục</h1>
            <a href="/Admin/Category" class="btn btn-default btn-sm">
                <i class="fas fa-arrow-left"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            @using (Html.BeginForm("Edit", "Category", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.id)
                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 px-3 mb-3", @style = "border-radius: 10px; font-size: 13px;" })

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="title">Tên danh mục <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.title, new { @class = "form-control", @placeholder = "Tên danh mục" })
                                @Html.ValidationMessageFor(x => x.title, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="parentID">Danh mục cha</label>
                                @Html.DropDownListFor(x => x.parentID, ViewBag.ParentCategories as SelectList, "— Là danh mục cha (cấp 1) —", new { @class = "form-control" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-0">
                        <label for="description">Mô tả</label>
                        @Html.TextBoxFor(x => x.description, new { @class = "form-control", @placeholder = "Mô tả ngắn cho danh mục" })
                        @Html.ValidationMessageFor(x => x.description, null, new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="card-footer d-flex align-items-center justify-content-end" style="gap: 8px;">
                    <a href="/Admin/Category" class="btn btn-default">Huỷ</a>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</section>
