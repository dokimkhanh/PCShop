@using PCShop.Models.Common
@using PCShop.Models.EF
@{
    ViewBag.Title = "Thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var pendingOrders = ViewBag.PendingOrders as List<Order> ?? new List<Order>();
    var lowStockProducts = ViewBag.LowStockProducts as List<Product> ?? new List<Product>();
    var incomeToday = ViewBag.IncomeToday != null ? Convert.ToInt32(ViewBag.IncomeToday) : 0;
    var revenue7Days = ViewBag.Revenue7DaysTotal != null ? Convert.ToInt32(ViewBag.Revenue7DaysTotal) : 0;
    var pendingCount = ViewBag.PendingOrdersCount != null ? Convert.ToInt32(ViewBag.PendingOrdersCount) : 0;
    var lowStockCount = ViewBag.LowStockCount != null ? Convert.ToInt32(ViewBag.LowStockCount) : 0;
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between">
            <h1>Thống kê tổng quan</h1>
            <a href="/Admin/Product/Add" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i>
                <span>Thêm sản phẩm</span>
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="kpi-strip">
            <a href="/Admin/Order" class="kpi-cell">
                <div class="kpi-top">
                    <span class="kpi-label">Đơn hàng hôm nay</span>
                    <span class="kpi-icon"><i class="fas fa-shopping-bag"></i></span>
                </div>
                <div class="kpi-value">@ViewBag.Orders</div>
                <div class="kpi-sub">
                    <span>@pendingCount đơn chưa thanh toán</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/Admin/Order?status=1" class="kpi-cell">
                <div class="kpi-top">
                    <span class="kpi-label">Thu nhập hôm nay</span>
                    <span class="kpi-icon"><i class="fas fa-wallet"></i></span>
                </div>
                <div class="kpi-value">@CommonHelper.ConvertMoney(incomeToday) đ</div>
                <div class="kpi-sub">
                    <span>Tính theo đơn đã thanh toán</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/Admin/Account" class="kpi-cell">
                <div class="kpi-top">
                    <span class="kpi-label">Khách hàng</span>
                    <span class="kpi-icon"><i class="fas fa-users"></i></span>
                </div>
                <div class="kpi-value">@ViewBag.Customers</div>
                <div class="kpi-sub">
                    <span>Tài khoản khách đã đăng ký</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>

            <a href="/Admin/Product" class="kpi-cell">
                <div class="kpi-top">
                    <span class="kpi-label">Sản phẩm</span>
                    <span class="kpi-icon"><i class="fas fa-laptop"></i></span>
                </div>
                <div class="kpi-value">@ViewBag.Products</div>
                <div class="kpi-sub">
                    <span>@lowStockCount mã sắp hết / hết hàng</span>
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title">Doanh thu 7 ngày gần nhất</h3>
                            <div style="font-size: 12.5px; color: var(--muted); margin-top: 2px;">
                                Tổng 7 ngày: <strong class="tabular-nums" style="color: var(--foreground);">@CommonHelper.ConvertMoney(revenue7Days) đ</strong>
                            </div>
                        </div>
                        <a href="/Admin/Order" class="btn btn-default btn-sm">Xem đơn hàng</a>
                    </div>
                    <div class="card-body">
                        <div style="position: relative; height: 280px;">
                            <canvas id="revenueBarChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Đơn chưa thanh toán</h3>
                        <a href="/Admin/Order?status=0" style="font-size: 12.5px; font-weight: 500; color: var(--primary);">Xem tất cả</a>
                    </div>
                    <div class="card-body">
                        @if (pendingOrders.Any())
                        {
                            foreach (var order in pendingOrders)
                            {
                                <div class="action-feed-item">
                                    <div style="min-width: 0;">
                                        <a href="/Admin/Order/View/@order.Id" class="tabular-nums" style="font-weight: 600; color: var(--foreground); display: block;">@order.code</a>
                                        <div style="font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 170px;">@order.customerName</div>
                                    </div>
                                    <div class="text-right" style="flex-shrink: 0;">
                                        <div class="tabular-nums" style="font-weight: 600; font-size: 13.5px;">@CommonHelper.ConvertMoney(order.totalAmount) đ</div>
                                        <a href="/Admin/Order/View/@order.Id" style="font-size: 12px; color: var(--primary);">Chi tiết</a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state" style="padding: 20px 10px;">
                                <div class="empty-state-title">Không có đơn tồn</div>
                                <div style="font-size: 12.5px;">Tất cả đơn hàng đã được xử lý.</div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Cảnh báo tồn kho</h3>
                        <a href="/Admin/Product" style="font-size: 12.5px; font-weight: 500; color: var(--primary);">Quản lý kho</a>
                    </div>
                    <div class="card-body">
                        @if (lowStockProducts.Any())
                        {
                            foreach (var product in lowStockProducts)
                            {
                                <div class="action-feed-item">
                                    <a href="/Admin/Product/Edit/@product.id" style="color: var(--foreground); font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 210px;" title="@product.title">@product.title</a>
                                    @if (product.quantity <= 0)
                                    {
                                        <span class="badge-clean badge-clean-danger">Hết hàng</span>
                                    }
                                    else
                                    {
                                        <span class="badge-clean badge-clean-warning tabular-nums">Còn @product.quantity</span>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state" style="padding: 20px 10px;">
                                <div class="empty-state-title">Tồn kho ổn định</div>
                                <div style="font-size: 12.5px;">Không có sản phẩm nào dưới ngưỡng 5 chiếc.</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script src="~/Content/client/plugins/chart.js/Chart.min.js"></script>
    <script>
        $(function () {
            var labels = @Html.Raw(ViewBag.RevenueLabelsJson ?? "[]");
            var values = @Html.Raw(ViewBag.RevenueValuesJson ?? "[]");
            var canvas = document.getElementById('revenueBarChart');
            if (!canvas || typeof Chart === 'undefined') {
                return;
            }
            var ctx = canvas.getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (đ)',
                        data: values,
                        backgroundColor: '#2563eb',
                        hoverBackgroundColor: '#1d4ed8',
                        borderRadius: 6,
                        barPercentage: 0.55,
                        categoryPercentage: 0.7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: 0 },
                    legend: { display: false },
                    tooltips: {
                        backgroundColor: '#18181b',
                        titleFontFamily: 'Inter, sans-serif',
                        bodyFontFamily: 'Inter, sans-serif',
                        callbacks: {
                            label: function (tooltipItem) {
                                var val = Number(tooltipItem.yLabel || 0);
                                return val.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    },
                    scales: {
                        xAxes: [{
                            gridLines: { display: false, drawBorder: false },
                            ticks: { fontColor: '#6b7280', fontFamily: 'Inter, sans-serif', fontSize: 12 }
                        }],
                        yAxes: [{
                            gridLines: { color: '#f0f0f3', drawBorder: false, zeroLineColor: '#e4e4e7' },
                            ticks: {
                                beginAtZero: true,
                                maxTicksLimit: 5,
                                fontColor: '#6b7280',
                                fontFamily: 'Inter, sans-serif',
                                fontSize: 12,
                                callback: function (value) {
                                    if (value >= 1000000) {
                                        return (value / 1000000).toFixed(1).replace(/\.0$/, '') + ' tr';
                                    }
                                    return Number(value).toLocaleString('vi-VN');
                                }
                            }
                        }]
                    }
                }
            });
        });
    </script>
}
