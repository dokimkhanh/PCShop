@model PagedList.PagedList<PCShop.Models.EF.News>
@using PagedList
@using PagedList.Mvc
@{
    ViewBag.Title = "Tin tức";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Quản lý tin tức</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="admin-toolbar">
            <div class="admin-toolbar-left">
                @using (Html.BeginForm("Index", "News", FormMethod.Get, new { @class = "d-flex align-items-center", @style = "gap: 8px;" }))
                {
                    <div class="admin-search-box">
                        <i class="fas fa-search search-icon"></i>
                        @Html.TextBox("txtSearch", Request["txtSearch"], new { @class = "form-control", @placeholder = "Tìm tiêu đề tin tức..." })
                    </div>
                    <button type="submit" class="btn btn-default">Tìm</button>
                }
            </div>

            <div class="admin-toolbar-right">
                <a href="#" class="btn btn-danger d-none" id="btnDeleteAll">
                    <i class="fas fa-trash-alt"></i>
                    <span id="deleteAllText">Xoá đã chọn</span>
                </a>
                <a href="/Admin/News/Add" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    <span>Thêm tin tức</span>
                </a>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 44px;">
                                <input type="checkbox" id="selectAll" aria-label="Chọn tất cả" />
                            </th>
                            <th>Bài viết</th>
                            <th>Ngày tạo</th>
                            <th>Cập nhật</th>
                            <th class="text-right" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var imgSrc = !string.IsNullOrWhiteSpace(item.image) ? item.image : fallbackImg;
                                <tr id="row_@item.id">
                                    <td>
                                        <input type="checkbox" class="selectRow" value="@item.id" aria-label="Chọn @item.title" />
                                    </td>
                                    <td>
                                        <div class="admin-item-cell">
                                            <img class="admin-thumb" src="@imgSrc" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.title" />
                                            <div class="admin-item-meta">
                                                <div class="admin-item-title" title="@item.title">@item.title</div>
                                                <div class="admin-item-sub">@(string.IsNullOrWhiteSpace(item.description) ? "—" : item.description)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="tabular-nums" style="color: var(--muted); white-space: nowrap;">
                                        @item.createdDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="tabular-nums" style="color: var(--muted); white-space: nowrap;">
                                        @(item.modifiedDate != DateTime.MinValue ? item.modifiedDate.ToString("dd/MM/yyyy") : "—")
                                    </td>
                                    <td class="text-right" style="white-space: nowrap;">
                                        <a href="/Admin/News/Edit/@item.id" class="btn-icon" title="Sửa" aria-label="Sửa">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <button type="button" data-id="@item.id" class="btn-icon btn-icon-danger btnDelete" title="Xoá" aria-label="Xoá">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        <div class="empty-state-icon"><i class="fas fa-newspaper"></i></div>
                                        <div class="empty-state-title">Chưa có tin tức nào</div>
                                        <a href="/Admin/News/Add" class="btn btn-primary btn-sm mt-2">Thêm tin tức mới</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model != null && Model.TotalItemCount > 0)
            {
                <div class="admin-table-footer">
                    <div>Hiển thị @Model.FirstItemOnPage–@Model.LastItemOnPage trong @Model.TotalItemCount bài viết</div>
                    @if (Model.PageCount > 1)
                    {
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, txtSearch = Request["txtSearch"] }))
                    }
                </div>
            }
        </div>
    </div>
</section>

@section scripts {
    <script>
        $(document).ready(function () {
            function syncBulkDeleteButton() {
                var selectedCount = $('.selectRow:checked').length;
                if (selectedCount > 0) {
                    $('#deleteAllText').text('Xoá ' + selectedCount + ' mục');
                    $('#btnDeleteAll').removeClass('d-none');
                } else {
                    $('#btnDeleteAll').addClass('d-none');
                }
            }

            $('body').on('change', '#selectAll', function () {
                $('.selectRow').prop('checked', this.checked);
                syncBulkDeleteButton();
            });

            $('body').on('change', '.selectRow', function () {
                var allChecked = $('.selectRow').length > 0 && $('.selectRow:checked').length === $('.selectRow').length;
                $('#selectAll').prop('checked', allChecked);
                syncBulkDeleteButton();
            });

            $('body').on('click', '#btnDeleteAll', function (e) {
                e.preventDefault();
                var ids = $('.selectRow:checked').map(function () { return $(this).val(); }).get().join(',');
                if (ids.length > 0) {
                    if (confirm('Bạn có muốn xoá các tin tức đã chọn không?')) {
                        $.ajax({
                            url: '/Admin/News/DeleteAll',
                            type: 'POST',
                            data: { ids: ids },
                            success: function (rs) {
                                if (rs.success) {
                                    location.reload();
                                }
                            }
                        });
                    }
                }
            });

            $('body').on('click', '.btnDelete', function () {
                var id = $(this).data('id');
                if (confirm('Bạn có chắc chắn muốn xoá tin tức này?')) {
                    $.ajax({
                        url: '/Admin/News/Delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (rs) {
                            if (rs.success) {
                                $('#row_' + id).remove();
                                syncBulkDeleteButton();
                                toastr.success('Đã xoá bài viết');
                            }
                        }
                    });
                }
            });
        });
    </script>
}
