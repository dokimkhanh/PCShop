@{
    ViewBag.Title = "Không có quyền truy cập";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<section class="content">
    <div class="container-fluid" style="padding-top: 40px;">
        <div class="card mx-auto" style="max-width: 520px;">
            <div class="card-body text-center py-5 px-4">
                <div class="empty-state-icon" style="width: 56px; height: 56px; font-size: 22px; background: var(--danger-bg); color: var(--danger);">
                    <i class="fas fa-lock"></i>
                </div>
                <h2 style="font-size: 18px; font-weight: 600; margin-top: 14px; margin-bottom: 6px;">Không có quyền truy cập</h2>
                <p style="color: var(--muted); font-size: 13.5px; margin-bottom: 20px;">
                    Tài khoản của bạn chưa được cấp quyền thực hiện chức năng này. Vui lòng liên hệ quản trị viên để được phân quyền.
                </p>
                @if (!string.IsNullOrWhiteSpace(ViewBag.RequiredPermissions as string))
                {
                    <div class="mb-4" style="font-size: 12px; color: var(--muted);">
                        Quyền yêu cầu: <code style="background: var(--background); padding: 2px 6px; border-radius: 6px; color: var(--foreground);">@ViewBag.RequiredPermissions</code>
                    </div>
                }
                <div class="d-flex align-items-center justify-content-center" style="gap: 8px;">
                    <a href="/Admin" class="btn btn-primary btn-sm">Về trang tổng quan</a>
                    <a href="/" class="btn btn-default btn-sm">Trang khách hàng</a>
                </div>
            </div>
        </div>
    </div>
</section>
