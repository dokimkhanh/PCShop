@using PCShop.Models.Common
@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var siteTitle = SettingsHelper.GetValue("SettingTitle");
    if (string.IsNullOrWhiteSpace(siteTitle))
    {
        siteTitle = "PCShop";
    }
    var userName = Request.IsAuthenticated && !string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name : "Admin";
    var userInitial = userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : userName.ToUpper();

    var canDashboard = PermissionHelper.HasPermission(User, "Dashboard.View");
    var canOrder = PermissionHelper.HasPermission(User, "Order.View", "Order.Manage");
    var canProduct = PermissionHelper.HasPermission(User, "Product.View", "Product.Manage");
    var canCategory = PermissionHelper.HasPermission(User, "Category.View", "Category.Manage");
    var canNews = PermissionHelper.HasPermission(User, "News.View", "News.Manage");
    var canAccount = PermissionHelper.HasPermission(User, "Account.View", "Account.Manage");
    var canRole = PermissionHelper.HasPermission(User, "Role.View", "Role.Manage");
    var canSetting = PermissionHelper.HasPermission(User, "Setting.View", "Setting.Manage");
}

<a href="/Admin" class="brand-link">
    <img src="/Content/images/favicon.png" alt="@siteTitle" style="width: 32px; height: 32px; object-fit: contain; flex-shrink: 0;" />
    <span class="brand-text-wrap">
        <span class="brand-title">@siteTitle</span>
        <span class="brand-subtitle">Quản trị cửa hàng</span>
    </span>
</a>

<div class="sidebar">
    <nav>
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            @if (canDashboard)
            {
                <li class="nav-item">
                    <a href="/Admin" class="nav-link @(currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <i class="nav-icon fas fa-chart-line"></i>
                        <p>Thống kê</p>
                    </a>
                </li>
            }

            @if (canOrder || canProduct || canCategory)
            {
                <li class="nav-header">Bán hàng</li>
                if (canOrder)
                {
                    <li class="nav-item">
                        <a href="/Admin/Order" class="nav-link @(currentController.Equals("Order", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-shopping-bag"></i>
                            <p>Đơn hàng</p>
                        </a>
                    </li>
                }
                if (canProduct)
                {
                    <li class="nav-item">
                        <a href="/Admin/Product" class="nav-link @(currentController.Equals("Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-laptop"></i>
                            <p>Sản phẩm</p>
                        </a>
                    </li>
                }
                if (canCategory)
                {
                    <li class="nav-item">
                        <a href="/Admin/Category" class="nav-link @(currentController.Equals("Category", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-tag"></i>
                            <p>Danh mục</p>
                        </a>
                    </li>
                }
            }

            @if (canNews || canProduct)
            {
                <li class="nav-header">Nội dung</li>
                if (canNews)
                {
                    <li class="nav-item">
                        <a href="/Admin/News" class="nav-link @(currentController.Equals("News", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-newspaper"></i>
                            <p>Tin tức</p>
                        </a>
                    </li>
                }
                if (canProduct)
                {
                    <li class="nav-item">
                        <a href="/Admin/Comment" class="nav-link @(currentController.Equals("Comment", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-comments"></i>
                            <p>Bình luận</p>
                        </a>
                    </li>
                }
            }

            @if (canAccount || canRole || canSetting)
            {
                <li class="nav-header">Hệ thống</li>
                if (canAccount)
                {
                    <li class="nav-item">
                        <a href="/Admin/Account" class="nav-link @(currentController.Equals("Account", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-users"></i>
                            <p>Tài khoản</p>
                        </a>
                    </li>
                }
                if (canRole)
                {
                    <li class="nav-item">
                        <a href="/Admin/Role" class="nav-link @(currentController.Equals("Role", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-user-shield"></i>
                            <p>Phân quyền</p>
                        </a>
                    </li>
                }
                if (canSetting)
                {
                    <li class="nav-item">
                        <a href="/Admin/PaymentMethod" class="nav-link @(currentController.Equals("PaymentMethod", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-credit-card"></i>
                            <p>Thanh toán</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Admin/SystemSettings" class="nav-link @(currentController.Equals("SystemSettings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                            <i class="nav-icon fas fa-cog"></i>
                            <p>Cấu hình hệ thống</p>
                        </a>
                    </li>
                }
            }
        </ul>
    </nav>

    @if (Request.IsAuthenticated)
    {
        <div class="sidebar-footer">
            <div class="sidebar-user-card">
                <span class="sidebar-user-avatar">@userInitial</span>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name" title="@userName">@userName</div>
                    <div class="sidebar-user-role">@(User.IsInRole("Admin") ? "Quản trị viên" : "Nhân viên")</div>
                </div>
                <button type="button" onclick="document.getElementById('logOffForm').submit()" class="btn-logout-icon" title="Đăng xuất" aria-label="Đăng xuất">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>

        <div style="display: none">
            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { @id = "logOffForm" }))
            {
                @Html.AntiForgeryToken()
            }
        </div>
    }
</div>
