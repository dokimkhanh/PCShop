@{
    var adminFavicon = PCShop.Models.Common.SettingsHelper.GetValue("SeoFavicon");
    if (string.IsNullOrWhiteSpace(adminFavicon)) { adminFavicon = "/favicon.ico"; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title | PCShop Quản trị</title>
    <link rel="icon" href="@adminFavicon" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/Content/client/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/Content/client/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/client/plugins/select2/css/select2.min.css">
    <link rel="stylesheet" href="~/Content/client/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css">
    <link rel="stylesheet" href="~/Content/toastr/toastr.css" />
    <link rel="stylesheet" href="~/Content/PagedList.css" />
    @{
        var adminCssPath = Server.MapPath("~/Content/admin-clean.css");
        var adminCssVer = System.IO.File.Exists(adminCssPath) ? System.IO.File.GetLastWriteTimeUtc(adminCssPath).Ticks.ToString() : "1";
    }
    <link rel="stylesheet" href="~/Content/admin-clean.css?v=@adminCssVer" />
</head>
<body class="hold-transition sidebar-mini layout-fixed admin-clean">
    @Html.AntiForgeryToken()
    <div class="wrapper">
        <nav class="main-header navbar navbar-expand navbar-light">
            <ul class="navbar-nav align-items-center">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Thu gọn menu">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item ml-2 d-none d-sm-inline-block">
                    <span class="navbar-page-title">@ViewBag.Title</span>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item">
                    <a href="/" class="btn btn-default btn-sm">
                        <i class="fas fa-external-link-alt"></i>
                        <span class="d-none d-sm-inline">Trang khách hàng</span>
                    </a>
                </li>
            </ul>
        </nav>

        <aside class="main-sidebar">
            @Html.Partial("_Sidebar")
        </aside>

        <div class="content-wrapper">
            @RenderBody()
        </div>

        <footer class="main-footer d-flex align-items-center justify-content-between">
            <span>&copy; @DateTime.Now.Year PCShop Quản trị</span>
            <span class="d-none d-sm-inline">Hệ thống quản lý bán hàng</span>
        </footer>
    </div>

    <script src="~/Content/client/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/client/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/client/plugins/bs-custom-file-input/bs-custom-file-input.min.js"></script>
    <script src="~/Content/client/dist/js/adminlte.min.js"></script>
    <script src="~/Content/client/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/Content/toastr/toastr.min.js"></script>
    <script>
        var afToken = $('input[name="__RequestVerificationToken"]').first().val();
        if (afToken) {
            $.ajaxSetup({
                beforeSend: function (xhr, settings) {
                    if (settings.type && settings.type.toUpperCase() === 'POST') {
                        xhr.setRequestHeader('__RequestVerificationToken', afToken);
                    }
                }
            });
        }
        $(function () {
            if (typeof bsCustomFileInput !== 'undefined') {
                bsCustomFileInput.init();
            }

            $('.admin-search-box').each(function () {
                var $box = $(this);
                var $input = $box.find('.form-control').first();
                if ($input.length === 0 || $box.find('.admin-search-clear').length > 0) {
                    return;
                }
                var initialVal = $.trim($input.val() || '');
                var $clearBtn = $('<button type="button" class="admin-search-clear" aria-label="Xoá từ khoá" title="Xoá từ khoá"><i class="fas fa-times"></i></button>');
                $box.append($clearBtn);

                function syncClearVisibility() {
                    $clearBtn.toggle(($input.val() || '').length > 0);
                }

                syncClearVisibility();
                $input.on('input change', syncClearVisibility);
                $clearBtn.on('click', function () {
                    $input.val('');
                    syncClearVisibility();
                    if (initialVal.length > 0) {
                        $input.closest('form').trigger('submit');
                    } else {
                        $input.trigger('focus');
                    }
                });
            });
        });
    </script>
    <script src="~/Content/ckeditor/ckeditor.js"></script>
    <script src="~/Scripts/admin-editor.js?v=20261118"></script>
    <script src="~/Scripts/admin-product-gallery.js?v=20261118"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
