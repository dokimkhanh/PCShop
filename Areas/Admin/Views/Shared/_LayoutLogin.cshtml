@{
    var loginFavicon = PCShop.Models.Common.SettingsHelper.GetValue("SeoFavicon");
    if (string.IsNullOrWhiteSpace(loginFavicon)) { loginFavicon = "/favicon.ico"; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập quản trị | PCShop</title>
    <link rel="icon" href="@loginFavicon" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/Content/client/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/Content/client/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/Content/admin-clean.css" />
</head>
<body class="admin-clean admin-login-body">
    <div class="admin-login-box">
        <div class="admin-login-card">
            @RenderBody()
        </div>
    </div>

    <script src="~/Content/client/plugins/jquery/jquery.min.js"></script>
    <script src="~/Content/client/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
