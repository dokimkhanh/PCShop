@model IEnumerable<PCShop.Models.EF.ProductImage>
@{
    ViewBag.Title = "Ảnh sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutEmpty.cshtml";
}

<section class="content p-3">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0">Ảnh sản phẩm</h5>
                <div>
                    <input type="file" id="productImgUploadInput" accept="image/*" multiple style="display: none;" />
                    <button type="button" id="btnAddProductImg" class="btn btn-success btn-sm">Thêm ảnh</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Ảnh</th>
                            <th style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr id="row_@item.Id">
                                    <td>@item.Id</td>
                                    <td><img class="imgProduct" src="@item.image" data-id="@item.Id" alt="Ảnh sản phẩm" width="120" /></td>
                                    <td>
                                        <a href="#" data-id="@item.Id" class="btn btn-danger btn-sm btnDeleteImg">Xoá</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section scripts{
    <script>
        $(document).ready(function () {
            var token = $('input[name="__RequestVerificationToken"]').first().val();

            $('body').on('click', '.btnDeleteImg', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                if (confirm('Bạn có chắc chắn muốn xoá?')) {
                    $.ajax({
                        url: '/Admin/ProductImage/Delete',
                        type: 'POST',
                        headers: token ? { '__RequestVerificationToken': token } : {},
                        data: { id: id },
                        success: function (rs) {
                            if (rs.success) {
                                $('#row_' + id).remove();
                            }
                        }
                    });
                }
            });

            $('#btnAddProductImg').on('click', function () {
                $('#productImgUploadInput').trigger('click');
            });

            $('#productImgUploadInput').on('change', function () {
                var files = this.files;
                if (!files || files.length === 0) {
                    return;
                }
                var formData = new FormData();
                for (var i = 0; i < files.length; i++) {
                    formData.append('files', files[i]);
                }
                $.ajax({
                    url: '/Admin/Upload/Image',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: token ? { '__RequestVerificationToken': token } : {},
                    success: function (res) {
                        if (res.success && res.urls && res.urls.length > 0) {
                            var pending = res.urls.length;
                            res.urls.forEach(function (url) {
                                $.ajax({
                                    url: '/Admin/ProductImage/AddImage',
                                    type: 'POST',
                                    headers: token ? { '__RequestVerificationToken': token } : {},
                                    data: { productID: @ViewBag.ProductID, url: url },
                                    complete: function () {
                                        pending--;
                                        if (pending <= 0) {
                                            window.location.reload();
                                        }
                                    }
                                });
                            });
                        }
                    }
                });
            });
        });
    </script>
}
