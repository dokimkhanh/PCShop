@model PagedList.PagedList<PCShop.Models.EF.Order>
@using PagedList
@using PagedList.Mvc
@{
    ViewBag.Title = "Quản lý đơn hàng";
    int? currentStatus = ViewBag.CurrentStatus as int?;
    string currentSearch = ViewBag.CurrentSearch as string;
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Quản lý đơn hàng</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="admin-toolbar">
            <div class="admin-toolbar-left">
                <div class="admin-tabs">
                    <a href="@Url.Action("Index", "Order", new { txtSearch = currentSearch })" class="admin-tab-item @(currentStatus == null ? "active" : "")">
                        <span>Tất cả</span>
                        <span class="admin-tab-count">@ViewBag.CountAll</span>
                    </a>
                    <a href="@Url.Action("Index", "Order", new { status = 0, txtSearch = currentSearch })" class="admin-tab-item @(currentStatus == 0 ? "active" : "")">
                        <span>Chưa thanh toán</span>
                        <span class="admin-tab-count">@ViewBag.CountPending</span>
                    </a>
                    <a href="@Url.Action("Index", "Order", new { status = 1, txtSearch = currentSearch })" class="admin-tab-item @(currentStatus == 1 ? "active" : "")">
                        <span>Đã thanh toán</span>
                        <span class="admin-tab-count">@ViewBag.CountPaid</span>
                    </a>
                    <a href="@Url.Action("Index", "Order", new { status = 2, txtSearch = currentSearch })" class="admin-tab-item @(currentStatus == 2 ? "active" : "")">
                        <span>Huỷ bỏ</span>
                        <span class="admin-tab-count">@ViewBag.CountCancelled</span>
                    </a>
                </div>
            </div>

            <div class="admin-toolbar-right">
                @using (Html.BeginForm("Index", "Order", FormMethod.Get, new { @class = "d-flex align-items-center", @style = "gap: 8px;" }))
                {
                    if (currentStatus.HasValue)
                    {
                        <input type="hidden" name="status" value="@currentStatus.Value" />
                    }
                    <div class="admin-search-box">
                        <i class="fas fa-search search-icon"></i>
                        <input type="search" name="txtSearch" value="@currentSearch" class="form-control" placeholder="Tìm mã đơn, tên, SĐT..." />
                    </div>
                    <button type="submit" class="btn btn-default">Tìm</button>
                }
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th class="text-right">Tổng tiền</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-right" style="width: 110px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="tabular-nums" style="font-weight: 600;">
                                        <a href="/Admin/Order/View/@item.Id" style="color: var(--foreground);">@item.code</a>
                                    </td>
                                    <td>
                                        <div class="admin-item-title">@item.customerName</div>
                                        <div class="admin-item-sub tabular-nums">@item.phone</div>
                                    </td>
                                    <td class="text-right tabular-nums" style="font-weight: 600; white-space: nowrap;">
                                        @PCShop.Models.Common.CommonHelper.ConvertMoney(item.totalAmount) đ
                                    </td>
                                    <td class="tabular-nums" style="color: var(--muted); white-space: nowrap;">
                                        @item.createdDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (item.paymentStatus == 0)
                                        {
                                            <span class="badge-clean badge-clean-warning">Chưa thanh toán</span>
                                        }
                                        else if (item.paymentStatus == 1)
                                        {
                                            <span class="badge-clean badge-clean-success">Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <span class="badge-clean badge-clean-danger">Huỷ bỏ</span>
                                        }
                                    </td>
                                    <td class="text-right" style="white-space: nowrap;">
                                        <a href="/Admin/Order/View/@item.Id" class="btn-icon" title="Xem chi tiết" aria-label="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <button type="button" data-id="@item.Id" data-status="@item.paymentStatus" data-code="@item.code" class="btn-icon btnUpdate" title="Cập nhật thanh toán" aria-label="Cập nhật thanh toán">
                                            <i class="fas fa-credit-card"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <div class="empty-state-icon"><i class="fas fa-shopping-bag"></i></div>
                                        <div class="empty-state-title">Không tìm thấy đơn hàng nào</div>
                                        <div style="font-size: 13px;">Thử đổi bộ lọc trạng thái hoặc từ khoá tìm kiếm.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model != null && Model.TotalItemCount > 0)
            {
                <div class="admin-table-footer">
                    <div>Hiển thị @Model.FirstItemOnPage–@Model.LastItemOnPage trong @Model.TotalItemCount đơn hàng</div>
                    @if (Model.PageCount > 1)
                    {
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, status = currentStatus, txtSearch = currentSearch }))
                    }
                </div>
            }
        </div>
    </div>
</section>

<div class="modal fade" id="modal-default" tabindex="-1" role="dialog" aria-labelledby="modalPaymentTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="modalPaymentTitle">Cập nhật thanh toán</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtOrderID" value="0" />
                <div class="mb-3 px-3 py-2" style="background: var(--background); border-radius: 10px; font-size: 13px;">
                    <span style="color: var(--muted);">Mã đơn hàng:</span>
                    <strong id="lblOrderCode" class="tabular-nums ml-1"></strong>
                </div>
                <div class="form-group mb-0">
                    <label for="paymentStatus">Trạng thái thanh toán</label>
                    <select class="form-control" id="paymentStatus">
                        <option value="0">Chưa thanh toán</option>
                        <option value="1">Đã thanh toán</option>
                        <option value="2">Huỷ bỏ</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSave">Lưu trạng thái</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('body').on('click', '.btnUpdate', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var status = $(this).data('status');
                var code = $(this).data('code');
                $('#txtOrderID').val(id);
                $('#paymentStatus').val(status);
                $('#lblOrderCode').text(code || '');
                $('#modal-default').modal('show');
            });

            $('body').on('click', '#btnSave', function () {
                var id = $('#txtOrderID').val();
                var status = $('#paymentStatus').val();
                $.ajax({
                    url: '/Admin/Order/UpdatePayment',
                    type: 'POST',
                    data: {
                        id: id,
                        status: status
                    },
                    success: function (res) {
                        if (res.Success) {
                            $('#modal-default').modal('hide');
                            toastr.options = {
                                closeButton: true,
                                progressBar: true,
                                positionClass: 'toast-top-right',
                                timeOut: '2000'
                            };
                            toastr.success('Cập nhật thanh toán thành công', 'Thông báo');
                            setTimeout(function () { location.reload(); }, 1000);
                        } else {
                            toastr.error('Không thể cập nhật trạng thái đơn hàng', 'Lỗi');
                        }
                    },
                    error: function () {
                        toastr.error('Lỗi kết nối máy chủ', 'Lỗi');
                    }
                });
            });
        });
    </script>
}
