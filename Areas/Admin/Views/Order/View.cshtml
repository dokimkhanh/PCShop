@model PCShop.Models.EF.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 12px;">
            <div class="d-flex align-items-center" style="gap: 10px;">
                <h1>Đơn hàng <span class="tabular-nums">@Model.code</span></h1>
                @if (Model.paymentStatus == 0)
                {
                    <span class="badge-clean badge-clean-warning">Chưa thanh toán</span>
                }
                else if (Model.paymentStatus == 1)
                {
                    <span class="badge-clean badge-clean-success">Đã thanh toán</span>
                }
                else
                {
                    <span class="badge-clean badge-clean-danger">Huỷ bỏ</span>
                }
            </div>
            <a href="/Admin/Order" class="btn btn-default btn-sm">
                <i class="fas fa-arrow-left"></i>
                <span>Quay lại đơn hàng</span>
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Thông tin khách hàng &amp; thanh toán</h3>
            </div>
            <div class="card-body">
                <div class="admin-info-grid">
                    <div class="admin-info-item">
                        <div class="admin-info-label">Mã đơn hàng</div>
                        <div class="admin-info-value tabular-nums">@Model.code</div>
                    </div>
                    <div class="admin-info-item">
                        <div class="admin-info-label">Khách hàng</div>
                        <div class="admin-info-value">@Model.customerName</div>
                    </div>
                    <div class="admin-info-item">
                        <div class="admin-info-label">Tổng thanh toán</div>
                        <div class="admin-info-value tabular-nums" style="font-weight: 600;">@PCShop.Models.Common.CommonHelper.ConvertMoney(Model.totalAmount) đ</div>
                    </div>
                    <div class="admin-info-item">
                        <div class="admin-info-label">Số điện thoại</div>
                        <div class="admin-info-value tabular-nums">@Model.phone</div>
                    </div>
                    <div class="admin-info-item">
                        <div class="admin-info-label">Email</div>
                        <div class="admin-info-value">@(string.IsNullOrWhiteSpace(Model.email) ? "—" : Model.email)</div>
                    </div>
                    <div class="admin-info-item">
                        <div class="admin-info-label">Ngày tạo</div>
                        <div class="admin-info-value tabular-nums">@Model.createdDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.address))
                {
                    <div class="admin-info-item mb-4">
                        <div class="admin-info-label">Địa chỉ giao hàng</div>
                        <div class="admin-info-value">@Model.address</div>
                    </div>
                }

                <div class="table-responsive" style="border: 1px solid var(--border-strong); border-radius: 12px; overflow: hidden;">
                    <table class="table">
                        <thead>
                            <tr>
                                <th style="width: 56px;">#</th>
                                <th>Sản phẩm</th>
                                <th class="text-right">Đơn giá</th>
                                <th class="text-right">Số lượng</th>
                                <th class="text-right">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.orderDetails != null && Model.orderDetails.Any())
                            {
                                var index = 1;
                                foreach (var item in Model.orderDetails)
                                {
                                    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
                                    var strImg = fallbackImg;
                                    if (item.product != null && item.product.productImages != null)
                                    {
                                        var checkImg = item.product.productImages.FirstOrDefault(x => x.isDefault) ?? item.product.productImages.FirstOrDefault();
                                        if (checkImg != null && !string.IsNullOrWhiteSpace(checkImg.image))
                                        {
                                            strImg = checkImg.image;
                                        }
                                    }

                                    var price = item.price > 0
                                        ? item.price
                                        : (item.product != null && item.product.priceSale > 0 ? item.product.priceSale : (item.product != null ? item.product.price : 0));

                                    <tr>
                                        <td class="tabular-nums" style="color: var(--muted);">@index</td>
                                        <td>
                                            <div class="admin-item-cell">
                                                <img class="admin-thumb" src="@strImg" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@(item.product != null ? item.product.title : "Sản phẩm")" />
                                                <div class="admin-item-meta">
                                                    <div class="admin-item-title">@(item.product != null ? item.product.title : "Sản phẩm đã xoá")</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-right tabular-nums" style="white-space: nowrap;">@PCShop.Models.Common.CommonHelper.ConvertMoney(price) đ</td>
                                        <td class="text-right tabular-nums">@item.quantity</td>
                                        <td class="text-right tabular-nums" style="font-weight: 600; white-space: nowrap;">@PCShop.Models.Common.CommonHelper.ConvertMoney(price * item.quantity) đ</td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-state">Không có sản phẩm nào trong đơn hàng này.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
