@model PCShop.Models.AdminRegisterViewModel
@{
    ViewBag.Title = "Thêm tài khoản mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var selectedSet = new HashSet<string>(Model.SelectedRoles ?? new List<string>(), StringComparer.OrdinalIgnoreCase);
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between">
            <h1>Thêm tài khoản mới</h1>
            <a href="/Admin/Account" class="btn btn-default btn-sm">
                <i class="fas fa-arrow-left"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="card-body">
                    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger py-2 px-3 mb-3", @style = "border-radius: 10px; font-size: 13px;" })

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="UserName">Tên đăng nhập <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", @placeholder = "Tối thiểu 4 ký tự" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="FullName">Họ và tên <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.FullName, new { @class = "form-control", @placeholder = "Nhập họ và tên" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Email">Email <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", @placeholder = "email@domain.com" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Phone">Số điện thoại</label>
                                @Html.TextBoxFor(x => x.Phone, new { @class = "form-control tabular-nums", @placeholder = "Số điện thoại" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="Password">Mật khẩu <span class="text-danger">*</span></label>
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control", @placeholder = "Tối thiểu 6 ký tự" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ConfirmPassword">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                                @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", @placeholder = "Nhập lại mật khẩu" })
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 mt-2" style="border-top: 1px solid var(--border);">
                        <label class="mb-2">Gán nhóm quyền <span class="text-danger">*</span></label>
                        <div style="font-size: 12.5px; color: var(--muted); margin-bottom: 12px;">Có thể chọn một hoặc nhiều nhóm quyền cho tài khoản này</div>
                        <div class="row">
                            @if (Model.AvailableRoles != null)
                            {
                                var idx = 0;
                                foreach (var roleName in Model.AvailableRoles)
                                {
                                    var isChecked = selectedSet.Contains(roleName);
                                    <div class="col-sm-6 col-md-4 mb-2">
                                        <div style="border: 1px solid var(--border-strong); border-radius: 10px; padding: 10px 14px; background: var(--surface-hover);">
                                            <div class="custom-control custom-checkbox">
                                                <input type="checkbox" class="custom-control-input" id="role_@idx" name="SelectedRoles" value="@roleName" @(isChecked ? "checked" : "") />
                                                <label class="custom-control-label" for="role_@idx" style="font-weight: 500; cursor: pointer;">@roleName</label>
                                            </div>
                                        </div>
                                    </div>
                                    idx++;
                                }
                            }
                        </div>
                        @Html.ValidationMessage("SelectedRoles", null, new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="card-footer d-flex align-items-center justify-content-end" style="gap: 8px;">
                    <a href="/Admin/Account" class="btn btn-default">Huỷ</a>
                    <button type="submit" class="btn btn-primary">Thêm tài khoản</button>
                </div>
            }
        </div>
    </div>
</section>
