@model PCShop.Models.EF.Product
@using Newtonsoft.Json
@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var existingImages = Model.productImages != null
        ? Model.productImages.Select(x => new { url = x.image, isDefault = x.isDefault }).ToList()
        : new[] { new { url = "", isDefault = false } }.Where(x => false).ToList();
    var existingImagesJson = JsonConvert.SerializeObject(existingImages);
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex align-items-center justify-content-between">
            <h1>Sửa sản phẩm</h1>
            <a href="/Admin/Product" class="btn btn-default btn-sm">
                <i class="fas fa-arrow-left"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            @using (Html.BeginForm("Edit", "Product", FormMethod.Post, new { @id = "productForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.id)
                <div class="card-body">
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 px-3 mb-3", @style = "border-radius: 10px; font-size: 13px;" })

                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="title">Tên sản phẩm <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.title, new { @class = "form-control", @placeholder = "Tên sản phẩm" })
                                @Html.ValidationMessageFor(x => x.title, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="productCode">Mã SKU</label>
                                <div class="d-flex" style="gap: 6px;">
                                    @Html.TextBoxFor(x => x.productCode, new { @class = "form-control", @placeholder = "Để trống sẽ giữ nguyên hoặc tự tạo" })
                                    <button type="button" id="btnGenSku" class="btn btn-default btn-sm flex-shrink-0" title="Tạo mã SKU ngẫu nhiên">Tạo mã</button>
                                </div>
                                @Html.ValidationMessageFor(x => x.productCode, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="categoryID">Danh mục sản phẩm <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(x => x.categoryID, ViewBag.productCategoryID as SelectList, "Chọn danh mục", new { @class = "form-control" })
                                @Html.ValidationMessageFor(x => x.categoryID, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="description">Mô tả ngắn</label>
                                @Html.TextBoxFor(x => x.description, new { @class = "form-control", @placeholder = "Mô tả ngắn" })
                                @Html.ValidationMessageFor(x => x.description, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="txtPrice">Giá gốc (đ) <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.price, new { @class = "form-control tabular-nums", @id = "txtPrice", @placeholder = "0" })
                                @Html.ValidationMessageFor(x => x.price, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="txtSale">Giá khuyến mãi (đ)</label>
                                @Html.TextBoxFor(x => x.priceSale, new { @class = "form-control tabular-nums", @id = "txtSale", @placeholder = "0" })
                                @Html.ValidationMessageFor(x => x.priceSale, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="quantity">Số lượng tồn kho <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(x => x.quantity, new { @class = "form-control tabular-nums", @placeholder = "0" })
                                @Html.ValidationMessageFor(x => x.quantity, null, new { @class = "text-danger small" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Thuộc tính hiển thị</label>
                        <div class="d-flex flex-wrap" style="gap: 20px;">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(x => x.isNew, new { @class = "custom-control-input", @id = "checkIsNew" })
                                <label for="checkIsNew" class="custom-control-label" style="font-weight: 400;">Hàng mới về</label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(x => x.isSale, new { @class = "custom-control-input", @id = "checkIsSale" })
                                <label for="checkIsSale" class="custom-control-label" style="font-weight: 400;">Hàng giảm giá</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="d-flex flex-wrap align-items-center justify-content-between mb-1" style="gap: 8px;">
                            <label for="txtDetail" class="mb-0">Chi tiết sản phẩm</label>
                            <div class="d-flex align-items-center" style="gap: 10px;">
                                <span style="font-size: 12px; color: var(--muted);">Kéo thả hoặc dán ảnh (Ctrl+V) trực tiếp vào khung soạn thảo</span>
                                <button type="button" id="btnInsertEditorImage" class="btn btn-default btn-sm">
                                    <i class="fas fa-image"></i>
                                    <span>Chèn ảnh nhanh</span>
                                </button>
                            </div>
                        </div>
                        @Html.TextAreaFor(x => x.detail, new { @class = "form-control", @id = "txtDetail" })
                        @Html.ValidationMessageFor(x => x.detail, null, new { @class = "text-danger small" })
                    </div>

                    <div id="product-images" class="pmg-section">
                        <input type="file" id="productMediaFileInput" class="pmg-file-input" accept="image/*" multiple style="display: none;" />
                        <div class="pmg-header">
                            <div>
                                <div class="pmg-header-left">
                                    <h3 class="pmg-title">Hình ảnh sản phẩm</h3>
                                    <span class="badge-clean badge-clean-neutral tabular-nums pmg-count-badge">0 ảnh</span>
                                </div>
                                <div class="pmg-subtitle">Ảnh đầu tiên là ảnh đại diện ngoài cửa hàng. Kéo thả thẻ ảnh để sắp xếp lại thứ tự hoặc nhấn vào ảnh để xem lớn.</div>
                            </div>
                            <label for="productMediaFileInput" class="btn btn-default btn-sm mb-0 pmg-header-add d-none" style="cursor: pointer;">
                                <i class="fas fa-upload"></i>
                                <span>Thêm ảnh</span>
                            </label>
                        </div>

                        <label for="productMediaFileInput" class="pmg-empty-dropzone">
                            <p class="pmg-drop-title pmg-drop-title-drag">Kéo thả hình ảnh sản phẩm vào đây</p>
                            <p class="pmg-drop-hint">JPG, PNG, WEBP, GIF — tối đa 10 MB mỗi ảnh, chọn nhiều ảnh cùng lúc</p>
                            <span class="pmg-drop-btn">
                                <i class="fas fa-upload"></i>
                                <span>Chọn ảnh từ máy</span>
                            </span>
                        </label>

                        <div class="pmg-grid" style="display: none;"></div>
                        <ul class="pmg-queue" style="display: none;"></ul>
                        <div class="pmg-hidden-inputs"></div>
                        <input type="hidden" name="rdDefault" value="0" />
                    </div>
                </div>

                <div class="card-footer d-flex align-items-center justify-content-end" style="gap: 8px;">
                    <a href="/Admin/Product" class="btn btn-default">Huỷ</a>
                    <button type="submit" id="btnSubmitProduct" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            }
        </div>
    </div>
</section>

@section scripts {
    <script>
        $(document).ready(function () {
            window.initAdminEditor('txtDetail', '#btnInsertEditorImage');
            window.initProductMediaGallery({
                rootSelector: '#product-images',
                submitButtonSelector: '#btnSubmitProduct',
                initialImages: @Html.Raw(existingImagesJson)
            });

            $('#btnGenSku').on('click', function () {
                var $btn = $(this);
                var catId = $('#categoryID').val() || 0;
                $btn.prop('disabled', true);
                $.getJSON('/Admin/Product/GenerateSku', { categoryId: catId })
                    .done(function (res) {
                        if (res && res.success && res.sku) {
                            $('#productCode').val(res.sku);
                        }
                    })
                    .always(function () {
                        $btn.prop('disabled', false);
                    });
            });
        });
    </script>
}
