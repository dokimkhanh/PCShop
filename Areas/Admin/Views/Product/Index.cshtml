@model PagedList<PCShop.Models.EF.Product>
@using PagedList
@using PagedList.Mvc
@{
    ViewBag.Title = "Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Quản lý sản phẩm</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="admin-toolbar">
            <div class="admin-toolbar-left">
                @using (Html.BeginForm("Index", "Product", FormMethod.Get, new { @class = "d-flex align-items-center", @style = "gap: 8px;" }))
                {
                    <div class="admin-search-box">
                        <i class="fas fa-search search-icon"></i>
                        @Html.TextBox("txtSearch", Request["txtSearch"], new { @class = "form-control", @placeholder = "Nhập tên sản phẩm..." })
                    </div>
                    <button type="submit" class="btn btn-default">Tìm</button>
                }
            </div>

            <div class="admin-toolbar-right">
                <a href="#" class="btn btn-danger d-none" id="btnDeleteAll">
                    <i class="fas fa-trash-alt"></i>
                    <span id="deleteAllText">Xoá đã chọn</span>
                </a>
                <a href="/Admin/Product/Add" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    <span>Thêm sản phẩm</span>
                </a>
            </div>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="width: 44px;">
                                <input type="checkbox" id="selectAll" aria-label="Chọn tất cả" />
                            </th>
                            <th>Sản phẩm</th>
                            <th class="text-right">Giá bán / Sale</th>
                            <th class="text-right">Tồn kho</th>
                            <th>Cập nhật</th>
                            <th class="text-right" style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var strImg = fallbackImg;
                                if (item.productImages != null)
                                {
                                    var checkImg = item.productImages.FirstOrDefault(x => x.isDefault) ?? item.productImages.FirstOrDefault();
                                    if (checkImg != null && !string.IsNullOrWhiteSpace(checkImg.image))
                                    {
                                        strImg = checkImg.image;
                                    }
                                }

                                <tr id="row_@item.id">
                                    <td>
                                        <input type="checkbox" class="selectRow" value="@item.id" aria-label="Chọn @item.title" />
                                    </td>
                                    <td>
                                        <a href="/Admin/Product/Edit/@item.id" class="admin-item-cell" style="text-decoration: none;">
                                            <img class="admin-thumb" src="@strImg" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.title" />
                                            <div class="admin-item-meta">
                                                <div class="admin-item-title" title="@item.title">@item.title</div>
                                                <div class="admin-item-sub">@(item.productCategory != null ? item.productCategory.title : "Chưa phân loại")</div>
                                            </div>
                                        </a>
                                    </td>
                                    <td class="text-right tabular-nums" style="white-space: nowrap;">
                                        @if (item.priceSale > 0 && item.priceSale < item.price)
                                        {
                                            <div style="font-weight: 600;">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.priceSale) đ</div>
                                            <div style="font-size: 12px; color: var(--muted); text-decoration: line-through;">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</div>
                                        }
                                        else
                                        {
                                            <div style="font-weight: 600;">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</div>
                                        }
                                    </td>
                                    <td class="text-right" style="white-space: nowrap;">
                                        @if (item.quantity <= 0)
                                        {
                                            <span class="badge-clean badge-clean-danger">Hết hàng</span>
                                        }
                                        else if (item.quantity <= 5)
                                        {
                                            <span class="badge-clean badge-clean-warning tabular-nums">Sắp hết (@item.quantity)</span>
                                        }
                                        else
                                        {
                                            <span class="tabular-nums" style="font-weight: 500;">@item.quantity</span>
                                        }
                                    </td>
                                    <td class="tabular-nums" style="color: var(--muted); white-space: nowrap;">
                                        @(item.modifiedDate != DateTime.MinValue ? item.modifiedDate.ToString("dd/MM/yyyy") : item.createdDate.ToString("dd/MM/yyyy"))
                                    </td>
                                    <td class="text-right" style="white-space: nowrap;">
                                        <a href="/Admin/Product/Edit/@item.id" class="btn-icon" title="Sửa sản phẩm & ảnh" aria-label="Sửa sản phẩm">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <button type="button" data-id="@item.id" class="btn-icon btn-icon-danger btnDelete" title="Xoá sản phẩm" aria-label="Xoá sản phẩm">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <div class="empty-state-icon"><i class="fas fa-laptop"></i></div>
                                        <div class="empty-state-title">Chưa có sản phẩm nào</div>
                                        <div style="font-size: 13px; margin-bottom: 14px;">Thêm sản phẩm đầu tiên để bắt đầu quản lý kho hàng.</div>
                                        <a href="/Admin/Product/Add" class="btn btn-primary btn-sm">Thêm sản phẩm mới</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model != null && Model.TotalItemCount > 0)
            {
                <div class="admin-table-footer">
                    <div>Hiển thị @Model.FirstItemOnPage–@Model.LastItemOnPage trong @Model.TotalItemCount sản phẩm</div>
                    @if (Model.PageCount > 1)
                    {
                        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, txtSearch = Request["txtSearch"] }))
                    }
                </div>
            }
        </div>
    </div>
</section>

@section scripts {
    <script>
        $(document).ready(function () {
            function syncBulkDeleteButton() {
                var selectedCount = $('.selectRow:checked').length;
                if (selectedCount > 0) {
                    $('#deleteAllText').text('Xoá ' + selectedCount + ' mục');
                    $('#btnDeleteAll').removeClass('d-none');
                } else {
                    $('#btnDeleteAll').addClass('d-none');
                }
            }

            $('body').on('change', '#selectAll', function () {
                $('.selectRow').prop('checked', this.checked);
                syncBulkDeleteButton();
            });

            $('body').on('change', '.selectRow', function () {
                var allChecked = $('.selectRow').length > 0 && $('.selectRow:checked').length === $('.selectRow').length;
                $('#selectAll').prop('checked', allChecked);
                syncBulkDeleteButton();
            });

            $('body').on('click', '.btnDelete', function () {
                var id = $(this).data('id');
                if (confirm('Bạn có chắc chắn muốn xoá sản phẩm này?')) {
                    $.ajax({
                        url: '/Admin/Product/Delete',
                        type: 'POST',
                        data: { id: id },
                        success: function (rs) {
                            if (rs.success) {
                                $('#row_' + id).remove();
                                syncBulkDeleteButton();
                                toastr.success('Đã xoá sản phẩm');
                            }
                        }
                    });
                }
            });

            $('body').on('click', '#btnDeleteAll', function (e) {
                e.preventDefault();
                var ids = $('.selectRow:checked').map(function () { return $(this).val(); }).get().join(',');
                if (ids.length > 0) {
                    if (confirm('Bạn có muốn xoá các sản phẩm đã chọn không?')) {
                        $.ajax({
                            url: '/Admin/Product/DeleteAll',
                            type: 'POST',
                            data: { ids: ids },
                            success: function (rs) {
                                if (rs.success) {
                                    location.reload();
                                }
                            }
                        });
                    }
                }
            });
        });
    </script>
}
