@model IEnumerable<PCShop.Models.EF.Product>
@{
    var category = ViewBag.Category as PCShop.Models.EF.Category;
    var firstItem = Model != null ? Model.FirstOrDefault() : null;
    var categoryTitle = category != null
        ? category.title
        : (firstItem != null && firstItem.productCategory != null ? firstItem.productCategory.title : "Danh mục sản phẩm");
    var categoryAlias = category != null
        ? category.alias
        : (firstItem != null && firstItem.productCategory != null ? firstItem.productCategory.alias : "");
    var categoryId = category != null
        ? category.id
        : (firstItem != null && firstItem.productCategory != null ? firstItem.productCategory.id : 0);
    ViewBag.Title = categoryTitle;

    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentSort = ViewBag.CurrentSort as string ?? "";
    var productCount = Model != null ? Model.Count() : 0;
    var formAction = categoryId > 0 ? "/danh-muc/" + categoryAlias + "/" + categoryId : "/san-pham";
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/san-pham">Sản phẩm</a>
        <span class="sep">/</span>
        <span class="current">@categoryTitle</span>
    </nav>

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <div class="sf-card p-3" style="position: sticky; top: 124px;">
                <h2 style="font-size: 15px; font-weight: 700; margin: 4px 8px 12px;">Danh mục sản phẩm</h2>
                @Html.Action("MenuProductCategoryLeft", "Menu", new { id = categoryId > 0 ? (int?)categoryId : null })
            </div>
        </aside>

        <section class="col-lg-9">
            <div class="sf-card p-3 mb-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 12px;">
                    <div>
                        <h1 style="font-size: 20px; font-weight: 700; margin: 0;">@categoryTitle</h1>
                        <div style="font-size: 13px; color: var(--sf-muted); margin-top: 2px;">
                            <span class="sf-tabular">@productCount</span> sản phẩm
                            @if (!string.IsNullOrWhiteSpace(currentSearch))
                            {
                                <span>cho từ khóa "<strong>@currentSearch</strong>"</span>
                                <a href="@formAction" class="ml-2" style="color: var(--sf-primary); font-weight: 500;">Xóa bộ lọc</a>
                            }
                        </div>
                    </div>

                    <form action="@formAction" method="get" class="d-flex flex-wrap align-items-center" style="gap: 8px;">
                        <input type="search" name="txtSearch" value="@currentSearch" class="form-control" placeholder="Tìm trong danh mục..." style="width: 210px; height: 38px; border-radius: 10px; font-size: 13px; border-color: var(--sf-border-strong);" />
                        <select name="sort" onchange="this.form.submit()" class="form-control" aria-label="Sắp xếp sản phẩm" style="width: 175px; height: 38px; border-radius: 10px; font-size: 13px; border-color: var(--sf-border-strong);">
                            <option value="" @(string.IsNullOrEmpty(currentSort) ? "selected" : "")>Mới nhất</option>
                            <option value="price_asc" @(currentSort == "price_asc" ? "selected" : "")>Giá: Thấp đến cao</option>
                            <option value="price_desc" @(currentSort == "price_desc" ? "selected" : "")>Giá: Cao đến thấp</option>
                            <option value="name_asc" @(currentSort == "name_asc" ? "selected" : "")>Tên: A - Z</option>
                        </select>
                        <button type="submit" class="sf-btn-primary" style="min-height: 38px; padding: 0 14px;">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="sf-product-grid-3">
                    @foreach (var item in Model)
                    {
                        var strImg = fallbackImg;
                        if (item.productImages != null)
                        {
                            var img = item.productImages.FirstOrDefault(x => x.isDefault) ?? item.productImages.FirstOrDefault();
                            if (img != null && !string.IsNullOrWhiteSpace(img.image))
                            {
                                strImg = img.image;
                            }
                        }
                        var hasSale = item.priceSale > 0 && item.priceSale < item.price;
                        var discountPct = hasSale && item.price > 0 ? (int)System.Math.Round((decimal)(item.price - item.priceSale) * 100 / item.price) : 0;

                        <article class="sf-product-card">
                            <a href="/san-pham/@item.alias-p@(item.id)" class="sf-product-thumb">
                                <div class="sf-badge-wrap">
                                    <div>
                                        @if (item.isNew)
                                        {
                                            <span class="sf-badge sf-badge-new">Mới</span>
                                        }
                                    </div>
                                    <div>
                                        @if (hasSale && discountPct > 0)
                                        {
                                            <span class="sf-badge sf-badge-sale">-@discountPct%</span>
                                        }
                                    </div>
                                </div>
                                <img src="@strImg" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.title" />
                            </a>
                            <div class="sf-product-body">
                                <div class="sf-product-cat">@categoryTitle</div>
                                <h3 class="sf-product-title">
                                    <a href="/san-pham/@item.alias-p@(item.id)" title="@item.title">@item.title</a>
                                </h3>
                                <div class="sf-price-row">
                                    @if (hasSale)
                                    {
                                        <span class="sf-price-now">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.priceSale) đ</span>
                                        <span class="sf-price-old">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</span>
                                    }
                                    else
                                    {
                                        <span class="sf-price-now">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</span>
                                    }
                                </div>
                                <a href="#" class="sf-btn-cart btnAddToCart" data-id="@item.id">
                                    <i class="fa fa-cart-plus" aria-hidden="true"></i>
                                    <span>Thêm vào giỏ</span>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="sf-card p-5 text-center">
                    <div class="mb-3" style="font-size: 36px; color: #d4d4d8;"><i class="fa fa-inbox" aria-hidden="true"></i></div>
                    <h3 style="font-size: 17px; font-weight: 600; margin-bottom: 6px;">Danh mục này hiện chưa có sản phẩm</h3>
                    <p style="color: var(--sf-muted); margin-bottom: 18px;">Hãy quay lại sau hoặc khám phá các dòng sản phẩm khác đang có sẵn tại PCShop.</p>
                    <a href="/san-pham" class="sf-btn-primary">Xem tất cả sản phẩm</a>
                </div>
            }
        </section>
    </div>
</div>
