@model IEnumerable<PCShop.Models.EF.Product>
@{
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
}
@if (Model != null && Model.Any())
{
    <div class="sf-section-head">
        <div>
            <h2 class="sf-section-title">Ưu đãi giá tốt</h2>
            <div class="sf-section-sub">Các mẫu PC, laptop và linh kiện đang giảm giá hấp dẫn</div>
        </div>
        <a href="/san-pham?sort=price_asc" class="sf-link-all">Xem thêm khuyến mãi <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
    </div>

    <div class="sf-product-grid">
        @foreach (var item in Model)
        {
            var strImg = fallbackImg;
            if (item.productImages != null)
            {
                var img = item.productImages.FirstOrDefault(x => x.isDefault) ?? item.productImages.FirstOrDefault();
                if (img != null && !string.IsNullOrWhiteSpace(img.image))
                {
                    strImg = img.image;
                }
            }
            var hasSale = item.priceSale > 0 && item.priceSale < item.price;
            var discountPct = hasSale && item.price > 0 ? (int)System.Math.Round((decimal)(item.price - item.priceSale) * 100 / item.price) : 0;
            var catTitle = item.productCategory != null ? item.productCategory.title : "Khuyến mãi";

            <article class="sf-product-card">
                <a href="/san-pham/@item.alias-p@(item.id)" class="sf-product-thumb">
                    <div class="sf-badge-wrap">
                        <div>
                            @if (item.isNew)
                            {
                                <span class="sf-badge sf-badge-new">Mới</span>
                            }
                        </div>
                        <div>
                            @if (hasSale && discountPct > 0)
                            {
                                <span class="sf-badge sf-badge-sale">-@discountPct%</span>
                            }
                            else
                            {
                                <span class="sf-badge sf-badge-sale">Ưu đãi</span>
                            }
                        </div>
                    </div>
                    <img src="@strImg" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.title" />
                </a>
                <div class="sf-product-body">
                    <div class="sf-product-cat">@catTitle</div>
                    <h3 class="sf-product-title">
                        <a href="/san-pham/@item.alias-p@(item.id)" title="@item.title">@item.title</a>
                    </h3>
                    <div class="sf-price-row">
                        @if (hasSale)
                        {
                            <span class="sf-price-now">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.priceSale) đ</span>
                            <span class="sf-price-old">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</span>
                        }
                        else
                        {
                            <span class="sf-price-now">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</span>
                        }
                    </div>
                    <a href="#" class="sf-btn-cart btnAddToCart" data-id="@item.id">
                        <i class="fa fa-cart-plus" aria-hidden="true"></i>
                        <span>Thêm vào giỏ</span>
                    </a>
                </div>
            </article>
        }
    </div>
}
