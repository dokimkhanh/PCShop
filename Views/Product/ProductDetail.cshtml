@model PCShop.Models.EF.Product
@using PCShop.Models.EF
@{
    ViewBag.Title = Model.title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
    var images = Model.productImages != null
        ? Model.productImages.Where(x => !string.IsNullOrWhiteSpace(x.image)).ToList()
        : new System.Collections.Generic.List<ProductImage>();
    var defaultImgObj = images.FirstOrDefault(x => x.isDefault) ?? images.FirstOrDefault();
    var mainImg = defaultImgObj != null ? defaultImgObj.image : fallbackImg;
    var hasSale = Model.priceSale > 0 && Model.priceSale < Model.price;
    var discountPct = hasSale && Model.price > 0 ? (int)System.Math.Round((decimal)(Model.price - Model.priceSale) * 100 / Model.price) : 0;
    var allComments = ViewBag.Comments as System.Collections.Generic.List<ProductComment> ?? new System.Collections.Generic.List<ProductComment>();
    var activeCommentCount = allComments.Count(c => !c.IsDeleted);
    var rootComments = allComments.Where(c => !c.ParentId.HasValue).OrderByDescending(c => c.CreatedDate).ToList();
    var repliesLookup = allComments.Where(c => c.ParentId.HasValue)
        .GroupBy(c => c.ParentId.Value)
        .ToDictionary(g => g.Key, g => g.OrderBy(r => r.CreatedDate).ToList());
    var canModerate = ViewBag.CanModerateComments != null && (bool)ViewBag.CanModerateComments;
    var currentUserName = ViewBag.CurrentUserName as string ?? "";
    var currentUserEmail = ViewBag.CurrentUserEmail as string ?? "";
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/san-pham">Sản phẩm</a>
        @if (Model.productCategory != null)
        {
            <span class="sep">/</span>
            <a href="/danh-muc/@Model.productCategory.alias/@Model.productCategory.id">@Model.productCategory.title</a>
        }
        <span class="sep">/</span>
        <span class="current">@Model.title</span>
    </nav>

    <div class="sf-card p-4 mb-4">
        <div class="row">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <div class="sf-detail-gallery">
                    <div class="sf-detail-main-img">
                        @if (images.Count > 1)
                        {
                            <button type="button" id="sfGalleryPrev" class="sf-detail-nav-btn sf-detail-nav-prev" aria-label="Ảnh trước">
                                <i class="fa fa-angle-left" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="sfGalleryNext" class="sf-detail-nav-btn sf-detail-nav-next" aria-label="Ảnh tiếp theo">
                                <i class="fa fa-angle-right" aria-hidden="true"></i>
                            </button>
                            <span id="sfGalleryCounter" class="sf-detail-counter">1 / @images.Count</span>
                        }
                        <img id="sfMainProductImg" src="@mainImg" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@Model.title" />
                    </div>
                    @if (images.Count > 1)
                    {
                        var thumbIdx = 0;
                        <div class="sf-detail-thumbs">
                            @foreach (var img in images)
                            {
                                var isActive = string.Equals(img.image, mainImg, System.StringComparison.OrdinalIgnoreCase);
                                <button type="button" class="sf-detail-thumb-btn @(isActive ? "active" : "")" data-src="@img.image" data-idx="@thumbIdx" aria-label="Xem ảnh @(thumbIdx + 1)">
                                    <img src="@img.image" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@Model.title" />
                                </button>
                                thumbIdx++;
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6 d-flex flex-column">
                <div class="d-flex flex-wrap align-items-center mb-2" style="gap: 8px;">
                    @if (Model.productCategory != null)
                    {
                        <a href="/danh-muc/@Model.productCategory.alias/@Model.productCategory.id" class="sf-badge" style="background: var(--sf-bg); color: var(--sf-muted); text-decoration: none;">@Model.productCategory.title</a>
                    }
                    @if (Model.isNew)
                    {
                        <span class="sf-badge sf-badge-new">Mới</span>
                    }
                    @if (hasSale && discountPct > 0)
                    {
                        <span class="sf-badge sf-badge-sale">-@discountPct%</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.productCode))
                    {
                        <span style="font-size: 12px; color: var(--sf-muted);">SKU: @Model.productCode</span>
                    }
                </div>

                <h1 style="font-size: 24px; font-weight: 700; line-height: 1.3; margin-bottom: 10px;">@Model.title</h1>

                @if (!string.IsNullOrWhiteSpace(Model.description))
                {
                    <p style="font-size: 14px; color: var(--sf-muted); margin-bottom: 16px;">@Model.description</p>
                }

                <div class="p-3 mb-4" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px;">
                    <div class="d-flex flex-wrap align-items-baseline" style="gap: 12px;">
                        @if (hasSale)
                        {
                            <span class="sf-tabular" style="font-size: 26px; font-weight: 700; color: var(--sf-primary);">@PCShop.Models.Common.CommonHelper.ConvertMoney(Model.priceSale) đ</span>
                            <span class="sf-tabular" style="font-size: 15px; color: var(--sf-muted); text-decoration: line-through;">@PCShop.Models.Common.CommonHelper.ConvertMoney(Model.price) đ</span>
                        }
                        else
                        {
                            <span class="sf-tabular" style="font-size: 26px; font-weight: 700; color: var(--sf-primary);">@PCShop.Models.Common.CommonHelper.ConvertMoney(Model.price) đ</span>
                        }
                    </div>
                    <div class="mt-2" style="font-size: 13px;">
                        @if (Model.quantity > 0)
                        {
                            <span class="sf-status-pill sf-status-success">Còn hàng (<span class="sf-tabular">@Model.quantity</span> sản phẩm)</span>
                        }
                        else
                        {
                            <span class="sf-status-pill sf-status-danger">Tạm hết hàng</span>
                        }
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center mb-4" style="gap: 12px;">
                    <div class="d-flex align-items-center" style="gap: 10px;">
                        <span style="font-size: 13.5px; font-weight: 600;">Số lượng</span>
                        <div class="sf-qty-stepper">
                            <button type="button" id="sfQtyMinus" aria-label="Giảm số lượng" tabindex="-1" disabled>
                                <span class="sf-qty-hit"><i class="fa fa-minus" aria-hidden="true"></i></span>
                            </button>
                            <span id="quantity_value" class="sf-qty-val">1</span>
                            <button type="button" id="sfQtyPlus" aria-label="Tăng số lượng" tabindex="-1">
                                <span class="sf-qty-hit"><i class="fa fa-plus" aria-hidden="true"></i></span>
                            </button>
                        </div>
                    </div>

                    <a href="#" class="sf-btn-primary btnAddToCart flex-grow-1" data-id="@Model.id" style="min-height: 44px;">
                        <i class="fa fa-cart-plus" aria-hidden="true"></i>
                        <span>Thêm vào giỏ hàng</span>
                    </a>
                </div>

                <div class="mt-auto pt-3 d-flex flex-column" style="border-top: 1px solid var(--sf-border); gap: 8px; font-size: 13px; color: var(--sf-muted);">
                    <div><i class="fa fa-truck mr-2" style="color: var(--sf-primary); width: 16px;"></i>Miễn phí giao hàng toàn quốc, đóng gói chống sốc cẩn thận</div>
                    <div><i class="fa fa-shield mr-2" style="color: var(--sf-primary); width: 16px;"></i>Bảo hành chính hãng, hỗ trợ kỹ thuật nhanh chóng</div>
                    <div><i class="fa fa-check-circle-o mr-2" style="color: var(--sf-primary); width: 16px;"></i>Thanh toán khi nhận hàng (COD), kiểm tra sản phẩm trước khi trả tiền</div>
                </div>
            </div>
        </div>
    </div>

    <div class="sf-card" id="commentsSection">
        <div class="sf-tabs-bar" role="tablist" aria-label="Thông tin sản phẩm">
            <button type="button" class="sf-tab-btn active" data-tab="#sfTabDetail" role="tab" aria-selected="true" tabindex="0">Chi tiết sản phẩm</button>
            <button type="button" class="sf-tab-btn" data-tab="#sfTabComments" role="tab" aria-selected="false" tabindex="-1">
                <span>Bình luận</span>
                <span id="sfCommentCountTab" class="sf-tab-count">@activeCommentCount</span>
            </button>
        </div>

        <div id="sfTabDetail" class="sf-tab-pane p-4" role="tabpanel">
            @if (!string.IsNullOrWhiteSpace(Model.detail))
            {
                <div class="sf-rich-content">
                    @Html.Raw(Model.detail)
                </div>
            }
            else
            {
                <p class="mb-0" style="color: var(--sf-muted);">Thông tin chi tiết sản phẩm đang được cập nhật.</p>
            }
        </div>

        <div id="sfTabComments" class="sf-tab-pane p-4" role="tabpanel" style="display: none;">
            <div class="sf-comment-heading">
                <h2>Bình luận</h2>
                <span id="sfCommentCountHeading" class="sf-comment-heading-count">@activeCommentCount</span>
            </div>

            <form id="sfCommentForm" class="sf-comment-composer">
                <input type="hidden" id="commentProductId" value="@Model.id" />
                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label for="commentAuthorName" style="font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Tên của bạn <span class="text-danger">*</span></label>
                        <input type="text" id="commentAuthorName" class="sf-comment-input" value="@currentUserName" placeholder="Nhập tên hiển thị..." maxlength="120" required />
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label for="commentAuthorEmail" style="font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Email <span style="color: var(--sf-muted); font-weight: 400;">(không bắt buộc)</span></label>
                        <input type="email" id="commentAuthorEmail" class="sf-comment-input" value="@currentUserEmail" placeholder="ban@email.com" maxlength="180" />
                    </div>
                </div>
                <div class="form-group mb-3">
                    <label for="commentContent" style="font-size: 13px; font-weight: 500; margin-bottom: 6px; display: block;">Nội dung bình luận <span class="text-danger">*</span></label>
                    <textarea id="commentContent" class="sf-comment-input" rows="3" maxlength="2000" placeholder="Viết bình luận, đặt câu hỏi hoặc chia sẻ trải nghiệm về sản phẩm..." required></textarea>
                </div>
                <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 10px;">
                    <span style="font-size: 12px; color: var(--sf-muted);">Mọi người đều có thể bình luận và trả lời trực tiếp.</span>
                    <button type="submit" id="btnSubmitComment" class="sf-comment-submit-btn" disabled>Gửi bình luận</button>
                </div>
            </form>

            <div id="sfCommentList">
                @if (rootComments.Any())
                {
                    foreach (var comment in rootComments)
                    {
                        var initial = !string.IsNullOrWhiteSpace(comment.AuthorName)
                            ? comment.AuthorName.Trim().Substring(0, 1).ToUpperInvariant()
                            : "K";
                        var replies = repliesLookup.ContainsKey(comment.Id)
                            ? repliesLookup[comment.Id]
                            : new System.Collections.Generic.List<ProductComment>();

                        <div class="sf-comment-item" id="comment_@comment.Id">
                            @if (comment.IsDeleted)
                            {
                                <div class="sf-comment-row">
                                    <div class="sf-comment-avatar"><i class="fa fa-ban" aria-hidden="true" style="font-size: 12px; color: var(--sf-muted);"></i></div>
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <div class="sf-comment-meta">
                                            <span style="font-size: 13.5px; color: var(--sf-muted); font-style: italic;">Bình luận đã bị xoá</span>
                                            <span class="sf-comment-time" title="@comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")">@comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="sf-comment-row">
                                    <div class="sf-comment-avatar @(comment.IsAdminReply ? "is-admin" : "")">@initial</div>
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 8px;">
                                            <div class="sf-comment-meta">
                                                <span class="sf-comment-author">@comment.AuthorName</span>
                                                @if (comment.IsAdminReply)
                                                {
                                                    <span class="sf-admin-badge">Quản trị viên</span>
                                                }
                                                <span class="sf-comment-time" title="@comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")">@comment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                            </div>
                                            @if (canModerate)
                                            {
                                                <button type="button" class="sf-comment-danger-btn btnDeleteComment" data-id="@comment.Id">Xoá</button>
                                            }
                                        </div>
                                        <div class="sf-comment-body">@comment.Content</div>
                                        <div class="sf-comment-actions">
                                            <button type="button" class="sf-comment-ghost-btn btnToggleReply" data-parent="@comment.Id" data-mention="@comment.AuthorName">
                                                <i class="fa fa-reply" aria-hidden="true"></i>
                                                <span>Trả lời</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="sf-reply-slot" id="reply_slot_@comment.Id"></div>

                            <div class="sf-comment-replies" id="replies_@comment.Id" style="@(replies.Any() ? "" : "display:none;")">
                                @foreach (var reply in replies)
                                {
                                    var rInitial = !string.IsNullOrWhiteSpace(reply.AuthorName)
                                        ? reply.AuthorName.Trim().Substring(0, 1).ToUpperInvariant()
                                        : "K";
                                    <div class="sf-comment-reply-item" id="comment_@reply.Id">
                                        @if (reply.IsDeleted)
                                        {
                                            <div class="sf-comment-avatar"><i class="fa fa-ban" aria-hidden="true" style="font-size: 12px; color: var(--sf-muted);"></i></div>
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <div class="sf-comment-meta">
                                                    <span style="font-size: 13.5px; color: var(--sf-muted); font-style: italic;">Bình luận đã bị xoá</span>
                                                    <span class="sf-comment-time" title="@reply.CreatedDate.ToString("dd/MM/yyyy HH:mm")">@reply.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="sf-comment-avatar @(reply.IsAdminReply ? "is-admin" : "")">@rInitial</div>
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 8px;">
                                                    <div class="sf-comment-meta">
                                                        <span class="sf-comment-author">@reply.AuthorName</span>
                                                        @if (reply.IsAdminReply)
                                                        {
                                                            <span class="sf-admin-badge">Quản trị viên</span>
                                                        }
                                                        <span class="sf-comment-time" title="@reply.CreatedDate.ToString("dd/MM/yyyy HH:mm")">@reply.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                                    </div>
                                                    @if (canModerate)
                                                    {
                                                        <button type="button" class="sf-comment-danger-btn btnDeleteComment" data-id="@reply.Id">Xoá</button>
                                                    }
                                                </div>
                                                <div class="sf-comment-body">@reply.Content</div>
                                                @if (!comment.IsDeleted)
                                                {
                                                    <div class="sf-comment-actions">
                                                        <button type="button" class="sf-comment-ghost-btn btnToggleReply" data-parent="@comment.Id" data-mention="@reply.AuthorName">
                                                            <i class="fa fa-reply" aria-hidden="true"></i>
                                                            <span>Trả lời</span>
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div id="sfNoComments" class="py-3" style="font-size: 13.5px; color: var(--sf-muted);">
                        Chưa có bình luận nào.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(function () {
            var canModerate = @(canModerate ? "true" : "false");
            var defaultUserName = '@HttpUtility.JavaScriptStringEncode(currentUserName)';
            var defaultUserEmail = '@HttpUtility.JavaScriptStringEncode(currentUserEmail)';

            function switchTab(target) {
                $('.sf-tab-btn').removeClass('active').attr('aria-selected', 'false').attr('tabindex', '-1');
                $('.sf-tab-btn[data-tab="' + target + '"]').addClass('active').attr('aria-selected', 'true').attr('tabindex', '0');
                $('.sf-tab-pane').hide();
                $(target).show();
            }

            function updateCommentCount(nextCount) {
                var val = Math.max(0, nextCount);
                $('#sfCommentCountTab').text(val);
                $('#sfCommentCountHeading').text(val);
            }

            function syncMainSubmitState() {
                var hasName = $.trim($('#commentAuthorName').val()).length > 0;
                var hasContent = $.trim($('#commentContent').val()).length > 0;
                $('#btnSubmitComment').prop('disabled', !(hasName && hasContent));
            }

            $('#commentAuthorName, #commentContent').on('input', syncMainSubmitState);
            syncMainSubmitState();

            $('.sf-tabs-bar').on('keydown', '.sf-tab-btn', function (e) {
                var $tabs = $('.sf-tab-btn');
                var idx = $tabs.index(this);
                if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    var next = $tabs.eq((idx + 1) % $tabs.length);
                    switchTab(next.data('tab'));
                    next.focus();
                } else if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    var prev = $tabs.eq((idx - 1 + $tabs.length) % $tabs.length);
                    switchTab(prev.data('tab'));
                    prev.focus();
                }
            });

            if (window.location.hash && window.location.hash.indexOf('#comment_') === 0) {
                switchTab('#sfTabComments');
            }

            var $thumbBtns = $('.sf-detail-thumb-btn');
            var activeImgIdx = Math.max(0, $thumbBtns.index($thumbBtns.filter('.active').first()));

            function selectGalleryImage(idx) {
                if ($thumbBtns.length === 0) {
                    return;
                }
                if (idx < 0) {
                    idx = $thumbBtns.length - 1;
                }
                if (idx >= $thumbBtns.length) {
                    idx = 0;
                }
                activeImgIdx = idx;
                var $btn = $thumbBtns.eq(idx);
                $('#sfMainProductImg').attr('src', $btn.data('src'));
                $thumbBtns.removeClass('active');
                $btn.addClass('active');
                $('#sfGalleryCounter').text((idx + 1) + ' / ' + $thumbBtns.length);
            }

            if ($thumbBtns.length > 0) {
                $('#sfGalleryCounter').text((activeImgIdx + 1) + ' / ' + $thumbBtns.length);
            }

            $thumbBtns.on('click', function () {
                selectGalleryImage($thumbBtns.index(this));
            });

            $('#sfGalleryPrev').on('click', function () {
                selectGalleryImage(activeImgIdx - 1);
            });

            $('#sfGalleryNext').on('click', function () {
                selectGalleryImage(activeImgIdx + 1);
            });

            $('#sfQtyMinus, #sfQtyPlus').on('mousedown', function (e) {
                e.preventDefault();
            });

            $('#sfQtyMinus').on('click', function () {
                var qty = parseInt($('#quantity_value').text(), 10) || 1;
                if (qty > 1) {
                    var next = qty - 1;
                    $('#quantity_value').text(next);
                    $('#sfQtyMinus').prop('disabled', next <= 1);
                }
            });

            $('#sfQtyPlus').on('click', function () {
                var qty = parseInt($('#quantity_value').text(), 10) || 1;
                var next = qty + 1;
                $('#quantity_value').text(next);
                $('#sfQtyMinus').prop('disabled', false);
            });

            $('.sf-tab-btn').on('click', function () {
                switchTab($(this).data('tab'));
            });

            function buildReplyElement(item, rootParentId) {
                var $row = $('<div class="sf-comment-reply-item"></div>').attr('id', 'comment_' + item.id);
                var $avatar = $('<div class="sf-comment-avatar"></div>').text(item.initial || 'K');
                if (item.isAdminReply) {
                    $avatar.addClass('is-admin');
                }
                $row.append($avatar);

                var $wrap = $('<div class="flex-grow-1" style="min-width: 0;"></div>');
                var $head = $('<div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 8px;"></div>');
                var $meta = $('<div class="sf-comment-meta"></div>');
                $meta.append($('<span class="sf-comment-author"></span>').text(item.authorName));
                if (item.isAdminReply) {
                    $meta.append($('<span class="sf-admin-badge">Quản trị viên</span>'));
                }
                $meta.append($('<span class="sf-comment-time"></span>').attr('title', item.createdDate).text(item.createdDate));
                $head.append($meta);

                if (canModerate) {
                    $head.append(
                        $('<button type="button" class="sf-comment-danger-btn btnDeleteComment">Xoá</button>')
                            .attr('data-id', item.id)
                    );
                }

                $wrap.append($head);
                $wrap.append($('<div class="sf-comment-body"></div>').text(item.content));
                var $actions = $('<div class="sf-comment-actions"></div>');
                $actions.append(
                    $('<button type="button" class="sf-comment-ghost-btn btnToggleReply"><i class="fa fa-reply" aria-hidden="true"></i><span>Trả lời</span></button>')
                        .attr('data-parent', rootParentId)
                        .attr('data-mention', item.authorName)
                );
                $wrap.append($actions);
                $row.append($wrap);
                return $row;
            }

            function buildCommentElement(item) {
                var $item = $('<div class="sf-comment-item"></div>').attr('id', 'comment_' + item.id);
                var $row = $('<div class="sf-comment-row"></div>');
                var $avatar = $('<div class="sf-comment-avatar"></div>').text(item.initial || 'K');
                if (item.isAdminReply) {
                    $avatar.addClass('is-admin');
                }
                $row.append($avatar);

                var $contentWrap = $('<div class="flex-grow-1" style="min-width: 0;"></div>');
                var $head = $('<div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 8px;"></div>');
                var $meta = $('<div class="sf-comment-meta"></div>');
                $meta.append($('<span class="sf-comment-author"></span>').text(item.authorName));
                if (item.isAdminReply) {
                    $meta.append($('<span class="sf-admin-badge">Quản trị viên</span>'));
                }
                $meta.append($('<span class="sf-comment-time"></span>').attr('title', item.createdDate).text(item.createdDate));
                $head.append($meta);

                if (canModerate) {
                    $head.append(
                        $('<button type="button" class="sf-comment-danger-btn btnDeleteComment">Xoá</button>')
                            .attr('data-id', item.id)
                    );
                }

                $contentWrap.append($head);
                $contentWrap.append($('<div class="sf-comment-body"></div>').text(item.content));

                var $actions = $('<div class="sf-comment-actions"></div>');
                $actions.append(
                    $('<button type="button" class="sf-comment-ghost-btn btnToggleReply"><i class="fa fa-reply" aria-hidden="true"></i><span>Trả lời</span></button>')
                        .attr('data-parent', item.id)
                        .attr('data-mention', item.authorName)
                );
                $contentWrap.append($actions);
                $row.append($contentWrap);
                $item.append($row);
                $item.append($('<div class="sf-reply-slot"></div>').attr('id', 'reply_slot_' + item.id));
                $item.append($('<div class="sf-comment-replies" style="display:none;"></div>').attr('id', 'replies_' + item.id));
                return $item;
            }

            $('body').on('click', '.btnToggleReply', function () {
                var parentId = $(this).data('parent');
                var mention = $(this).data('mention') || '';
                var $slot = $('#reply_slot_' + parentId);

                if ($slot.children().length > 0) {
                    $slot.empty();
                    return;
                }

                $('.sf-reply-slot').empty();
                var savedName = $.trim($('#commentAuthorName').val()) || defaultUserName;
                var savedEmail = $.trim($('#commentAuthorEmail').val()) || defaultUserEmail;

                var $box = $('<div class="sf-reply-form-box"></div>');
                var $form = $('<form class="sf-reply-form-inner sfInlineReplyForm"></form>').attr('data-parent', parentId);
                var $row = $('<div class="row"></div>');
                var $colName = $('<div class="col-md-6 form-group mb-2"></div>');
                $colName.append($('<input type="text" class="sf-comment-input reply-name" placeholder="Tên của bạn *" maxlength="120" required />').val(savedName));
                var $colEmail = $('<div class="col-md-6 form-group mb-2"></div>');
                $colEmail.append($('<input type="email" class="sf-comment-input reply-email" placeholder="Email (không bắt buộc)" maxlength="180" />').val(savedEmail));
                $row.append($colName).append($colEmail);

                var $ta = $('<textarea class="sf-comment-input reply-content mb-2" rows="2" maxlength="2000" required></textarea>')
                    .attr('placeholder', 'Trả lời ' + mention + '...');
                if (mention) {
                    $ta.val('@@' + mention + ' ');
                }

                var $foot = $('<div class="d-flex justify-content-end" style="gap: 8px;"></div>');
                $foot.append($('<button type="button" class="sf-comment-cancel-btn btnCancelReply">Huỷ</button>'));
                var $submitReply = $('<button type="submit" class="sf-comment-submit-btn btnSubmitReply">Gửi trả lời</button>');
                $foot.append($submitReply);

                function syncReplyBtn() {
                    var ok = $.trim($form.find('.reply-name').val()).length > 0 && $.trim($ta.val()).length > 0;
                    $submitReply.prop('disabled', !ok);
                }
                $form.on('input', '.reply-name, .reply-content', syncReplyBtn);

                $form.append($row).append($ta).append($foot);
                $box.append($form);
                $slot.append($box);
                syncReplyBtn();
                $ta.focus();
            });

            $('body').on('click', '.btnCancelReply', function () {
                $(this).closest('.sf-reply-slot').empty();
            });

            $('body').on('submit', '.sfInlineReplyForm', function (e) {
                e.preventDefault();
                var $form = $(this);
                var parentId = $form.data('parent');
                var authorName = $.trim($form.find('.reply-name').val());
                var authorEmail = $.trim($form.find('.reply-email').val());
                var content = $.trim($form.find('.reply-content').val());
                var productId = $('#commentProductId').val();

                if (!authorName || !content) {
                    if (window.toastr) {
                        toastr.warning('Vui lòng nhập tên và nội dung trả lời.');
                    }
                    return;
                }

                var $btn = $form.find('.btnSubmitReply');
                $btn.prop('disabled', true);

                $.ajax({
                    url: '/Product/AddComment',
                    type: 'POST',
                    data: {
                        productId: productId,
                        parentId: parentId,
                        authorName: authorName,
                        authorEmail: authorEmail,
                        content: content
                    },
                    success: function (res) {
                        if (res && res.success && res.comment) {
                            var rootId = res.comment.parentId || parentId;
                            var $list = $('#replies_' + rootId);
                            $list.append(buildReplyElement(res.comment, rootId)).show();
                            $form.closest('.sf-reply-slot').empty();
                            var count = parseInt($('#sfCommentCountTab').text(), 10) || 0;
                            updateCommentCount(count + 1);
                            if (window.toastr) {
                                toastr.success('Đã gửi phản hồi thành công!');
                            }
                        } else if (window.toastr) {
                            toastr.error((res && res.message) || 'Không thể gửi trả lời.');
                        }
                    },
                    error: function () {
                        if (window.toastr) {
                            toastr.error('Lỗi kết nối khi gửi trả lời.');
                        }
                    },
                    complete: function () {
                        $btn.prop('disabled', false);
                    }
                });
            });

            $('#sfCommentForm').on('submit', function (e) {
                e.preventDefault();
                var authorName = $.trim($('#commentAuthorName').val());
                var authorEmail = $.trim($('#commentAuthorEmail').val());
                var content = $.trim($('#commentContent').val());
                var productId = $('#commentProductId').val();

                if (!authorName || !content) {
                    if (window.toastr) {
                        toastr.warning('Vui lòng nhập tên hiển thị và nội dung bình luận.');
                    }
                    return;
                }

                var $btn = $('#btnSubmitComment');
                $btn.prop('disabled', true);

                $.ajax({
                    url: '/Product/AddComment',
                    type: 'POST',
                    data: {
                        productId: productId,
                        authorName: authorName,
                        authorEmail: authorEmail,
                        content: content
                    },
                    success: function (res) {
                        if (res && res.success && res.comment) {
                            $('#sfNoComments').remove();
                            $('#sfCommentList').prepend(buildCommentElement(res.comment));
                            var count = parseInt($('#sfCommentCountTab').text(), 10) || 0;
                            updateCommentCount(count + 1);
                            $('#commentContent').val('');
                            syncMainSubmitState();
                            if (window.toastr) {
                                toastr.success('Đã gửi bình luận thành công!', 'Thông báo');
                            }
                        } else if (window.toastr) {
                            toastr.error((res && res.message) || 'Không thể gửi bình luận.');
                        }
                    },
                    error: function () {
                        if (window.toastr) {
                            toastr.error('Lỗi kết nối khi gửi bình luận.');
                        }
                    },
                    complete: function () {
                        syncMainSubmitState();
                    }
                });
            });

            $('body').on('click', '.btnDeleteComment', function () {
                var id = $(this).data('id');
                if (!confirm('Xoá bình luận này?')) {
                    return;
                }
                $.ajax({
                    url: '/Product/DeleteComment',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res && res.success) {
                            if (res.softDeleted) {
                                var $item = $('#comment_' + id);
                                var $avatar = $('<div class="sf-comment-avatar"><i class="fa fa-ban" aria-hidden="true" style="font-size: 12px; color: var(--sf-muted);"></i></div>');
                                var $body = $('<div class="flex-grow-1" style="min-width: 0;"></div>');
                                var $meta = $('<div class="sf-comment-meta"></div>');
                                $meta.append('<span style="font-size: 13.5px; color: var(--sf-muted); font-style: italic;">Bình luận đã bị xoá</span>');
                                if (res.createdDate) {
                                    $meta.append($('<span class="sf-comment-time"></span>').text(res.createdDate));
                                }
                                $body.append($meta);
                                if (res.isReply) {
                                    $item.empty().append($avatar).append($body);
                                } else {
                                    var $deletedRow = $('<div class="sf-comment-row"></div>');
                                    $deletedRow.append($avatar).append($body);
                                    $item.children('.sf-comment-row').replaceWith($deletedRow);
                                    $item.find('#reply_slot_' + id).empty();
                                    $item.find('.btnToggleReply').remove();
                                }
                            } else {
                                $('#comment_' + id).remove();
                                if (res.removedParentId) {
                                    $('#comment_' + res.removedParentId).remove();
                                }
                            }
                            var removed = typeof res.removedCount === 'number' ? res.removedCount : 1;
                            var count = (parseInt($('#sfCommentCountTab').text(), 10) || removed) - removed;
                            updateCommentCount(count);
                            if (window.toastr) {
                                toastr.success('Đã xoá bình luận.');
                            }
                        }
                    }
                });
            });
        });
    </script>
}
