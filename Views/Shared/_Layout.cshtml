@using PCShop.Models.Common
@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    var siteName = SettingsHelper.GetValue("SettingTitle");
    if (string.IsNullOrWhiteSpace(siteName)) { siteName = "PCShop"; }
    var defaultSeoTitle = SettingsHelper.GetValue("SeoMetaTitle");
    if (string.IsNullOrWhiteSpace(defaultSeoTitle)) { defaultSeoTitle = siteName; }
    var pageTitle = !string.IsNullOrWhiteSpace(ViewBag.Title as string)
        ? ViewBag.Title + " - " + siteName
        : defaultSeoTitle;
    var metaDesc = !string.IsNullOrWhiteSpace(ViewBag.MetaDescription as string)
        ? ViewBag.MetaDescription as string
        : SettingsHelper.GetValue("SeoMetaDescription");
    var metaKeywords = !string.IsNullOrWhiteSpace(ViewBag.MetaKeywords as string)
        ? ViewBag.MetaKeywords as string
        : SettingsHelper.GetValue("SeoMetaKeywords");
    var metaRobots = SettingsHelper.GetValue("SeoRobots");
    if (string.IsNullOrWhiteSpace(metaRobots)) { metaRobots = "index, follow"; }
    var metaAuthor = SettingsHelper.GetValue("SeoAuthor");
    var faviconUrl = SettingsHelper.GetValue("SeoFavicon");
    if (string.IsNullOrWhiteSpace(faviconUrl)) { faviconUrl = "/favicon.ico"; }
    var canonicalBase = (SettingsHelper.GetValue("SeoCanonicalBaseUrl") ?? "").TrimEnd('/');
    var currentPath = Request.Url != null ? Request.Url.AbsolutePath : "/";
    var canonicalUrl = !string.IsNullOrWhiteSpace(canonicalBase)
        ? canonicalBase + currentPath
        : (Request.Url != null ? Request.Url.GetLeftPart(UriPartial.Path) : "");
    var ogImage = !string.IsNullOrWhiteSpace(ViewBag.OgImage as string)
        ? ViewBag.OgImage as string
        : SettingsHelper.GetValue("SeoOgImage");
    if (!string.IsNullOrWhiteSpace(ogImage) && ogImage.StartsWith("/") && !string.IsNullOrWhiteSpace(canonicalBase))
    {
        ogImage = canonicalBase + ogImage;
    }
    var googleVerify = SettingsHelper.GetValue("SeoGoogleVerification");
    var gaId = SettingsHelper.GetValue("SeoGoogleAnalyticsId");
    var fbAppId = SettingsHelper.GetValue("SeoFacebookAppId");

    var notiText = SettingsHelper.GetValue("Noti");
    var hotline = SettingsHelper.GetValue("SettingHotline");
    var email = SettingsHelper.GetValue("SettingEmail");
    var address = SettingsHelper.GetValue("SettingAddress");
    var openHours = SettingsHelper.GetValue("SettingOpenHours");

    var fbUrl = SettingsHelper.GetValue("SocialFacebook");
    var ytUrl = SettingsHelper.GetValue("SocialYoutube");
    var igUrl = SettingsHelper.GetValue("SocialInstagram");
    var ttUrl = SettingsHelper.GetValue("SocialTiktok");
    var zaloUrl = SettingsHelper.GetValue("SocialZalo");

    var isAdminCapable = Request.IsAuthenticated && PermissionHelper.HasPermission(User);
    var categoryMenu = CategoryMenuHelper.GetMenuTree();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDesc))
    {
        <meta name="description" content="@metaDesc" />
    }
    @if (!string.IsNullOrWhiteSpace(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords" />
    }
    <meta name="robots" content="@metaRobots" />
    @if (!string.IsNullOrWhiteSpace(metaAuthor))
    {
        <meta name="author" content="@metaAuthor" />
    }
    @if (!string.IsNullOrWhiteSpace(googleVerify))
    {
        <meta name="google-site-verification" content="@googleVerify" />
    }
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <link rel="icon" href="@faviconUrl" />
    <link rel="shortcut icon" href="@faviconUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:title" content="@pageTitle" />
    @if (!string.IsNullOrWhiteSpace(metaDesc))
    {
        <meta property="og:description" content="@metaDesc" />
    }
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <meta property="og:url" content="@canonicalUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }
    @if (!string.IsNullOrWhiteSpace(fbAppId))
    {
        <meta property="fb:app_id" content="@fbAppId" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    @if (!string.IsNullOrWhiteSpace(metaDesc))
    {
        <meta name="twitter:description" content="@metaDesc" />
    }
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta name="twitter:image" content="@ogImage" />
    }
    @if (!string.IsNullOrWhiteSpace(gaId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" type="text/css" href="~/Content/assets/styles/bootstrap4/bootstrap.min.css" />
    <link href="~/Content/assets/plugins/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" type="text/css" href="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.carousel.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.theme.default.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/assets/plugins/jquery-ui-1.12.1.custom/jquery-ui.css" />
    <link href="~/Content/toastr/toastr.css" rel="stylesheet" />
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    @{
        var sfCssPath = Server.MapPath("~/Content/storefront-clean.css");
        var sfCssVer = System.IO.File.Exists(sfCssPath) ? System.IO.File.GetLastWriteTimeUtc(sfCssPath).Ticks.ToString() : "1";
    }
    <link href="~/Content/storefront-clean.css?v=@sfCssVer" rel="stylesheet" />

    <script src="~/Content/assets/js/jquery-3.2.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/Content/toastr/toastr.min.js"></script>
    <script>
        $(function () {
            var afToken = $('input[name="__RequestVerificationToken"]').first().val();
            if (afToken) {
                $.ajaxSetup({
                    beforeSend: function (xhr, settings) {
                        if (settings.type && settings.type.toUpperCase() === 'POST') {
                            xhr.setRequestHeader('__RequestVerificationToken', afToken);
                        }
                    }
                });
            }
        });
    </script>
</head>
<body class="sf-body">
    @Html.AntiForgeryToken()

    <header class="sf-header">
        <div class="sf-topbar">
            <div class="container">
                <div class="sf-topbar-inner">
                    <div class="sf-topbar-noti">
                        @(string.IsNullOrWhiteSpace(notiText) ? "PCShop — PC Gaming, Laptop & Linh kiện chính hãng" : notiText)
                    </div>
                    <div class="sf-account-dropdown">
                        @if (!Request.IsAuthenticated)
                        {
                            <a href="/Account/Login" class="sf-account-trigger">
                                <i class="fa fa-user-o" aria-hidden="true"></i>
                                <span>Tài khoản</span>
                                <i class="fa fa-angle-down" aria-hidden="true"></i>
                            </a>
                            <ul class="sf-account-menu">
                                <li><a href="/Account/Login"><i class="fa fa-sign-in" aria-hidden="true"></i>Đăng nhập</a></li>
                                <li><a href="/Account/Register"><i class="fa fa-user-plus" aria-hidden="true"></i>Đăng ký</a></li>
                            </ul>
                        }
                        else
                        {
                            <a href="/Account/Profile" class="sf-account-trigger">
                                <i class="fa fa-user-circle-o" aria-hidden="true"></i>
                                <span>@User.Identity.Name</span>
                                <i class="fa fa-angle-down" aria-hidden="true"></i>
                            </a>
                            <ul class="sf-account-menu">
                                <li><a href="/Account/Profile"><i class="fa fa-user-circle" aria-hidden="true"></i>Thông tin tài khoản</a></li>
                                @if (isAdminCapable)
                                {
                                    <li><a href="/Admin"><i class="fa fa-cog" aria-hidden="true"></i>Trang quản trị</a></li>
                                }
                                <li><a href="javascript:document.getElementById('logOffForm').submit()"><i class="fa fa-sign-out" aria-hidden="true"></i>Đăng xuất</a></li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="sf-navbar">
                <div class="sf-nav-left">
                    <a href="/" class="sf-logo">
                        <span class="sf-logo-mark">P</span>
                        <span class="sf-logo-text">PC<span>Shop</span></span>
                    </a>

                    @if (categoryMenu != null && categoryMenu.Any())
                    {
                        <div class="sf-mega-wrap" id="sfMegaWrap">
                            <button type="button" id="sfMegaTrigger" class="sf-mega-trigger" aria-expanded="false" aria-controls="sfMegaDropdown">
                                <i class="fa fa-bars" aria-hidden="true"></i>
                                <span>Danh mục sản phẩm</span>
                                <i class="fa fa-angle-down sf-mega-caret" aria-hidden="true"></i>
                            </button>

                            <div class="sf-mega-dropdown" id="sfMegaDropdown" role="region" aria-label="Danh mục sản phẩm">
                                <div class="sf-mega-left">
                                    <ul class="sf-mega-parents">
                                        @for (var i = 0; i < categoryMenu.Count; i++)
                                        {
                                            var root = categoryMenu[i];
                                            <li class="sf-mega-parent-item @(i == 0 ? "is-active" : "")" data-mega-idx="@i">
                                                <a href="/danh-muc/@root.Alias/@(root.Id)" class="sf-mega-parent-link">
                                                    <span class="sf-mega-parent-name">@root.Title</span>
                                                    <i class="fa fa-angle-right sf-mega-parent-arrow" aria-hidden="true"></i>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                    <div class="sf-mega-left-foot">
                                        <a href="/san-pham">
                                            <span>Xem tất cả sản phẩm</span>
                                            <i class="fa fa-arrow-right" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </div>

                                <div class="sf-mega-right">
                                    @for (var i = 0; i < categoryMenu.Count; i++)
                                    {
                                        var root = categoryMenu[i];
                                        <div class="sf-mega-pane @(i == 0 ? "is-active" : "")" data-mega-pane="@i">
                                            <div class="sf-mega-pane-head">
                                                <div>
                                                    <div class="sf-mega-pane-title">@root.Title</div>
                                                    @if (!string.IsNullOrWhiteSpace(root.Description))
                                                    {
                                                        <div class="sf-mega-pane-sub">@root.Description</div>
                                                    }
                                                </div>
                                                <a href="/danh-muc/@root.Alias/@(root.Id)" class="sf-mega-pane-all">
                                                    <span>Xem tất cả (@root.TotalProductCount)</span>
                                                    <i class="fa fa-angle-right" aria-hidden="true"></i>
                                                </a>
                                            </div>

                                            @if (root.Children.Any())
                                            {
                                                <div class="sf-mega-subgrid">
                                                    @foreach (var child in root.Children)
                                                    {
                                                        <a href="/danh-muc/@child.Alias/@(child.Id)" class="sf-mega-subitem">
                                                            <span class="sf-mega-subitem-name">@child.Title</span>
                                                            @if (child.DirectProductCount > 0)
                                                            {
                                                                <span class="sf-mega-subitem-count sf-tabular">@child.DirectProductCount SP</span>
                                                            }
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            else if (root.FeaturedProducts.Any())
                                            {
                                                <div class="sf-mega-prod-grid">
                                                    @foreach (var prod in root.FeaturedProducts)
                                                    {
                                                        var prodImg = string.IsNullOrWhiteSpace(prod.Image) ? Url.Content("~/Content/assets/images/product_1.png") : prod.Image;
                                                        <a href="/san-pham/@prod.Alias-p@(prod.Id)" class="sf-mega-prod-card">
                                                            <img src="@prodImg" alt="@prod.Title" />
                                                            <div class="sf-mega-prod-info">
                                                                <div class="sf-mega-prod-title" title="@prod.Title">@prod.Title</div>
                                                                <div class="sf-mega-prod-price sf-tabular">@CommonHelper.ConvertMoney(prod.EffectivePrice) đ</div>
                                                            </div>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="sf-mega-empty">
                                                    Khám phá tất cả sản phẩm thuộc nhóm <strong>@root.Title</strong> tại PCShop.
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <ul class="sf-nav-links">
                    <li><a href="/" class="@(currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Trang chủ</a></li>
                    <li><a href="/san-pham" class="@(currentController.Equals("Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Sản phẩm</a></li>
                    <li><a href="/tin-tuc" class="@(currentController.Equals("News", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Tin tức</a></li>
                    <li><a href="/lien-he" class="@(currentController.Equals("Contact", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Liên hệ</a></li>
                </ul>

                <div class="sf-nav-actions">
                    <form action="/san-pham" method="get" class="sf-header-search">
                        <input type="search" name="txtSearch" value="@Request["txtSearch"]" placeholder="Tìm PC, laptop, linh kiện..." aria-label="Tìm sản phẩm" />
                        <button type="submit" aria-label="Tìm kiếm"><i class="fa fa-search" aria-hidden="true"></i></button>
                    </form>

                    <a href="/Cart" class="sf-cart-btn" aria-label="Giỏ hàng">
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                        <span class="sf-cart-label">Giỏ hàng</span>
                        <span id="checkout_items" class="sf-cart-badge" style="display: none;">0</span>
                    </a>

                    <button type="button" id="btnOpenDrawer" class="sf-hamburger" aria-label="Mở menu">
                        <i class="fa fa-bars" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div class="sf-mobile-drawer-backdrop" id="sfDrawerBackdrop"></div>
    <aside class="sf-mobile-drawer" id="sfMobileDrawer" aria-label="Menu di động">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3" style="border-bottom: 1px solid var(--sf-border);">
            <span class="sf-logo-text" style="font-size: 18px;">PC<span>Shop</span></span>
            <button type="button" id="btnCloseDrawer" class="sf-hamburger" style="display: inline-flex;" aria-label="Đóng menu">
                <i class="fa fa-times" aria-hidden="true"></i>
            </button>
        </div>

        <form action="/san-pham" method="get" class="mb-3">
            <div class="input-group">
                <input type="search" name="txtSearch" class="form-control" placeholder="Tìm sản phẩm..." style="border-radius: 10px 0 0 10px; font-size: 13.5px;" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-danger" style="border-radius: 0 10px 10px 0; background: var(--sf-primary); border-color: var(--sf-primary);"><i class="fa fa-search"></i></button>
                </div>
            </div>
        </form>

        <ul class="sf-cat-list mb-3">
            <li class="@(currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a href="/">Trang chủ</a></li>
            <li class="@(currentController.Equals("Product", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a href="/san-pham">Tất cả sản phẩm</a></li>
            <li class="@(currentController.Equals("News", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a href="/tin-tuc">Tin tức</a></li>
            <li class="@(currentController.Equals("Contact", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a href="/lien-he">Liên hệ</a></li>
            <li class="@(currentController.Equals("Cart", StringComparison.OrdinalIgnoreCase) ? "active" : "")"><a href="/Cart">Giỏ hàng</a></li>
        </ul>

        @if (categoryMenu != null && categoryMenu.Any())
        {
            <div class="sf-mobile-cat-sec mb-4">
                <div class="sf-mobile-cat-heading">Danh mục sản phẩm</div>
                <ul class="sf-mobile-cat-list">
                    @foreach (var root in categoryMenu)
                    {
                        <li class="sf-mobile-cat-item">
                            <div class="sf-mobile-cat-row">
                                <a href="/danh-muc/@root.Alias/@(root.Id)" class="sf-mobile-cat-link">
                                    <span>@root.Title</span>
                                </a>
                                @if (root.Children.Any())
                                {
                                    <button type="button" class="sf-mobile-cat-toggle" aria-expanded="false" aria-label="Mở danh mục con @root.Title">
                                        <i class="fa fa-angle-down" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                            @if (root.Children.Any())
                            {
                                <ul class="sf-mobile-sub-list" style="display: none;">
                                    @foreach (var child in root.Children)
                                    {
                                        <li>
                                            <a href="/danh-muc/@child.Alias/@(child.Id)">@child.Title</a>
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="pt-3" style="border-top: 1px solid var(--sf-border);">
            @if (!Request.IsAuthenticated)
            {
                <a href="/Account/Login" class="sf-btn-primary w-100 mb-2">Đăng nhập</a>
                <a href="/Account/Register" class="sf-btn-outline w-100">Đăng ký tài khoản</a>
            }
            else
            {
                <a href="/Account/Profile" class="sf-btn-outline w-100 mb-2">Hồ sơ (@User.Identity.Name)</a>
                if (isAdminCapable)
                {
                    <a href="/Admin" class="sf-btn-outline w-100 mb-2">Trang quản trị</a>
                }
                <a href="javascript:document.getElementById('logOffForm').submit()" class="sf-btn-outline w-100" style="color: var(--sf-danger) !important;">Đăng xuất</a>
            }
        </div>
    </aside>

    <main class="sf-main">
        @RenderBody()
    </main>

    <footer class="sf-footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <a href="/" class="sf-logo mb-3">
                        <span class="sf-logo-mark">P</span>
                        <span class="sf-logo-text">PC<span>Shop</span></span>
                    </a>
                    <p class="mb-3" style="max-width: 380px;">@(string.IsNullOrWhiteSpace(metaDesc) ? "Chuyên cung cấp PC Gaming, Laptop hiệu năng cao và linh kiện máy tính chính hãng." : metaDesc)</p>
                    <div class="d-flex flex-column" style="gap: 6px; font-size: 13px;">
                        @if (!string.IsNullOrWhiteSpace(address))
                        {
                            <div><i class="fa fa-map-marker mr-2" style="width: 14px; color: var(--sf-primary);"></i>@address</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(hotline))
                        {
                            <div><i class="fa fa-phone mr-2" style="width: 14px; color: var(--sf-primary);"></i><a href="tel:@hotline.Replace(" ", "")" style="color: inherit;">@hotline</a></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <div><i class="fa fa-envelope-o mr-2" style="width: 14px; color: var(--sf-primary);"></i><a href="mailto:@email" style="color: inherit;">@email</a></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(openHours))
                        {
                            <div><i class="fa fa-clock-o mr-2" style="width: 14px; color: var(--sf-primary);"></i>@openHours</div>
                        }
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3 mb-4 mb-lg-0">
                    <h5>Điều hướng</h5>
                    <ul class="sf-footer-links">
                        <li><a href="/">Trang chủ</a></li>
                        <li><a href="/san-pham">Sản phẩm</a></li>
                        <li><a href="/tin-tuc">Tin tức công nghệ</a></li>
                        <li><a href="/lien-he">Liên hệ &amp; Bản đồ</a></li>
                        <li><a href="/Cart">Giỏ hàng của bạn</a></li>
                    </ul>
                </div>

                <div class="col-sm-6 col-lg-4">
                    <h5>Kết nối với chúng tôi</h5>
                    @{
                        var hasAnySocial = !string.IsNullOrWhiteSpace(fbUrl)
                            || !string.IsNullOrWhiteSpace(ytUrl)
                            || !string.IsNullOrWhiteSpace(igUrl)
                            || !string.IsNullOrWhiteSpace(ttUrl)
                            || !string.IsNullOrWhiteSpace(zaloUrl);
                    }
                    @if (hasAnySocial)
                    {
                        <div class="sf-social-row mb-3">
                            @if (!string.IsNullOrWhiteSpace(fbUrl))
                            {
                                <a href="@fbUrl" target="_blank" rel="noopener noreferrer" class="sf-social-link" title="Facebook" aria-label="Facebook"><i class="fa fa-facebook" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(ytUrl))
                            {
                                <a href="@ytUrl" target="_blank" rel="noopener noreferrer" class="sf-social-link" title="YouTube" aria-label="YouTube"><i class="fa fa-youtube-play" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(igUrl))
                            {
                                <a href="@igUrl" target="_blank" rel="noopener noreferrer" class="sf-social-link" title="Instagram" aria-label="Instagram"><i class="fa fa-instagram" aria-hidden="true"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(ttUrl))
                            {
                                <a href="@ttUrl" target="_blank" rel="noopener noreferrer" class="sf-social-link" title="TikTok" aria-label="TikTok" style="font-size: 12px; font-weight: 700;">TT</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(zaloUrl))
                            {
                                <a href="@zaloUrl" target="_blank" rel="noopener noreferrer" class="sf-social-link" title="Zalo" aria-label="Zalo" style="font-size: 11px; font-weight: 700;">Zalo</a>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="font-size: 13px;">Cập nhật liên kết mạng xã hội tại trang quản trị Cấu hình hệ thống.</p>
                    }
                    <p style="font-size: 12.5px; margin-bottom: 0;">Thanh toán khi nhận hàng (COD) an toàn, kiểm tra sản phẩm trước khi thanh toán.</p>
                </div>
            </div>

            <div class="sf-footer-bottom">
                <div>&copy; @DateTime.Now.Year @siteName. All Rights Reserved.</div>
                <div>Hỗ trợ mua hàng &amp; bảo hành chính hãng</div>
            </div>
        </div>
    </footer>

    @if (Request.IsAuthenticated)
    {
        <div style="display: none">
            @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { @id = "logOffForm" }))
            {
                @Html.AntiForgeryToken()
            }
        </div>
    }

    <script src="~/Content/assets/styles/bootstrap4/popper.js"></script>
    <script src="~/Content/assets/styles/bootstrap4/bootstrap.min.js"></script>
    <script src="~/Content/assets/plugins/Isotope/isotope.pkgd.min.js"></script>
    <script src="~/Content/assets/plugins/OwlCarousel2-2.2.1/owl.carousel.js"></script>
    <script src="~/Content/assets/plugins/easing/easing.js"></script>
    <script src="~/Content/assets/js/custom.js"></script>
    <script src="~/Scripts/cart.js"></script>
    <script>
        $(function () {
            $('#btnOpenDrawer').on('click', function () {
                $('body').addClass('sf-drawer-open');
            });
            $('#btnCloseDrawer, #sfDrawerBackdrop').on('click', function () {
                $('body').removeClass('sf-drawer-open');
            });

            var $megaWrap = $('#sfMegaWrap');
            var $megaTrigger = $('#sfMegaTrigger');
            var closeTimer = null;

            function setMegaOpen(open) {
                $megaWrap.toggleClass('is-open', open);
                $megaTrigger.attr('aria-expanded', open ? 'true' : 'false');
            }

            function activateMegaIdx(idx) {
                $megaWrap.find('.sf-mega-parent-item').removeClass('is-active');
                $megaWrap.find('.sf-mega-parent-item[data-mega-idx="' + idx + '"]').addClass('is-active');
                $megaWrap.find('.sf-mega-pane').removeClass('is-active');
                $megaWrap.find('.sf-mega-pane[data-mega-pane="' + idx + '"]').addClass('is-active');
            }

            $megaWrap.on('mouseenter', function () {
                if (closeTimer) {
                    clearTimeout(closeTimer);
                    closeTimer = null;
                }
                setMegaOpen(true);
            }).on('mouseleave', function () {
                closeTimer = setTimeout(function () {
                    setMegaOpen(false);
                }, 140);
            });

            $megaTrigger.on('click', function (e) {
                e.preventDefault();
                setMegaOpen(!$megaWrap.hasClass('is-open'));
            });

            $megaWrap.on('mouseenter focusin', '.sf-mega-parent-item', function () {
                activateMegaIdx($(this).data('mega-idx'));
            });

            $(document).on('click', function (e) {
                if ($megaWrap.length && !$(e.target).closest('#sfMegaWrap').length) {
                    setMegaOpen(false);
                }
            }).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    setMegaOpen(false);
                }
            });

            $('#sfMobileDrawer').on('click', '.sf-mobile-cat-toggle', function () {
                var $item = $(this).closest('.sf-mobile-cat-item');
                var willOpen = !$item.hasClass('is-open');
                $item.toggleClass('is-open', willOpen);
                $(this).attr('aria-expanded', willOpen ? 'true' : 'false');
                $item.children('.sf-mobile-sub-list').stop(true, true).slideToggle(160);
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
