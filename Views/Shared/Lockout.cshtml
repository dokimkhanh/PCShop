@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Tài khoản tạm khoá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <div class="sf-card p-4 p-md-5 text-center mx-auto" style="max-width: 520px;">
        <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width: 56px; height: 56px; border-radius: 16px; background: var(--sf-warning-bg); color: var(--sf-warning); font-size: 24px;">
            <i class="fa fa-lock" aria-hidden="true"></i>
        </div>
        <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 8px;">Tài khoản tạm thời bị khoá</h1>
        <p style="font-size: 14px; color: var(--sf-muted); margin-bottom: 20px;">Tài khoản của bạn bị tạm khoá do đăng nhập sai nhiều lần. Vui lòng thử lại sau ít phút.</p>
        <a href="/Account/Login" class="sf-btn-primary px-4">Quay lại đăng nhập</a>
    </div>
</div>
