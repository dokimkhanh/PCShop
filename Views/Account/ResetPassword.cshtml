@model PCShop.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Đặt lại mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <div class="sf-card p-4 p-md-5 mx-auto" style="max-width: 460px;">
        <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 4px;">Đặt lại mật khẩu</h1>
        <p style="font-size: 13.5px; color: var(--sf-muted); margin-bottom: 20px;">Nhập email và mật khẩu mới cho tài khoản của bạn.</p>

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger small mb-3" })
            @Html.HiddenFor(model => model.Code)

            <div class="form-group">
                <label for="Email" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Email <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Email, new { @class = "sf-comment-input", @placeholder = "ban@email.com", @type = "email" })
            </div>
            <div class="form-group">
                <label for="Password" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Mật khẩu mới <span class="text-danger">*</span></label>
                @Html.PasswordFor(m => m.Password, new { @class = "sf-comment-input", @placeholder = "Nhập mật khẩu mới", @autocomplete = "new-password" })
            </div>
            <div class="form-group mb-4">
                <label for="ConfirmPassword" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "sf-comment-input", @placeholder = "Nhập lại mật khẩu mới", @autocomplete = "new-password" })
            </div>

            <button type="submit" class="sf-btn-primary w-100" style="min-height: 42px;">Xác nhận đặt lại mật khẩu</button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
