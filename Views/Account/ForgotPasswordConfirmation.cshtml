@{
    ViewBag.Title = "Kiểm tra email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <div class="sf-card p-4 p-md-5 text-center mx-auto" style="max-width: 480px;">
        <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width: 56px; height: 56px; border-radius: 16px; background: var(--sf-success-bg); color: var(--sf-success); font-size: 24px;">
            <i class="fa fa-envelope-o" aria-hidden="true"></i>
        </div>
        <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 8px;">Vui lòng kiểm tra email</h1>
        <p style="font-size: 14px; color: var(--sf-muted); margin-bottom: 20px;">Nếu địa chỉ email tồn tại trong hệ thống, hướng dẫn đặt lại mật khẩu đã được gửi vào hộp thư của bạn.</p>
        <a href="/Account/Login" class="sf-btn-primary px-4">Quay lại đăng nhập</a>
    </div>
</div>
