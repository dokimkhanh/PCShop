@model PCShop.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <div class="sf-card p-4 p-md-5 mx-auto" style="max-width: 540px;">
        <div class="text-center mb-4">
            <img src="/Content/images/logo.png" alt="PCShop" class="mx-auto mb-3 d-block" style="height: 40px; width: auto; object-fit: contain;" />
            <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 4px;">Tạo tài khoản mới</h1>
            <p style="font-size: 13.5px; color: var(--sf-muted); margin: 0;">Đăng ký để đặt hàng nhanh hơn và theo dõi lịch sử mua hàng dễ dàng.</p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "text-danger small mb-3" })

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="UserName" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Tên đăng nhập <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.UserName, new { @class = "sf-comment-input", @placeholder = "Nhập tên đăng nhập", @autocomplete = "username" })
                </div>
                <div class="col-md-6 form-group">
                    <label for="FullName" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Họ và tên <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.FullName, new { @class = "sf-comment-input", @placeholder = "Nguyễn Văn A" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="Email" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Email <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "sf-comment-input", @placeholder = "ban@email.com", @type = "email" })
                </div>
                <div class="col-md-6 form-group">
                    <label for="Phone" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.Phone, new { @class = "sf-comment-input", @placeholder = "09xx xxx xxx", @type = "tel" })
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label for="Password" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Mật khẩu <span class="text-danger">*</span></label>
                    @Html.PasswordFor(m => m.Password, new { @class = "sf-comment-input", @placeholder = "Nhập mật khẩu", @autocomplete = "new-password" })
                </div>
                <div class="col-md-6 form-group">
                    <label for="ConfirmPassword" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "sf-comment-input", @placeholder = "Xác nhận mật khẩu", @autocomplete = "new-password" })
                </div>
            </div>

            @Html.TextBoxFor(m => m.Role, new { @Value = "361a9fa5-0ec3-4154-ba7f-c25f858031bb", @type = "hidden" })

            <button type="submit" class="sf-btn-primary w-100 mt-2" style="min-height: 42px;">Đăng ký tài khoản</button>
        }

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--sf-border); font-size: 13.5px; color: var(--sf-muted);">
            Đã có tài khoản?
            <a href="/Account/Login" style="color: var(--sf-primary); font-weight: 600; text-decoration: none;">Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
