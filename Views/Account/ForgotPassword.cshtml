@model PCShop.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <div class="sf-card p-4 p-md-5 mx-auto" style="max-width: 440px;">
        <div class="text-center mb-4">
            <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width: 46px; height: 46px; border-radius: 12px; background: var(--sf-primary-light); color: var(--sf-primary); font-size: 20px;">
                <i class="fa fa-key" aria-hidden="true"></i>
            </div>
            <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 4px;">Quên mật khẩu</h1>
            <p style="font-size: 13.5px; color: var(--sf-muted); margin: 0;">Nhập email đã đăng ký để nhận hướng dẫn đặt lại mật khẩu.</p>
        </div>

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger small mb-3" })

            <div class="form-group mb-4">
                <label for="Email" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Email <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Email, new { @class = "sf-comment-input", @placeholder = "ban@email.com", @type = "email" })
            </div>

            <button type="submit" class="sf-btn-primary w-100" style="min-height: 42px;">Gửi yêu cầu đặt lại mật khẩu</button>
        }

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--sf-border); font-size: 13.5px;">
            <a href="/Account/Login" style="color: var(--sf-muted); text-decoration: none;">
                <i class="fa fa-angle-left mr-1" aria-hidden="true"></i>Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
