@using PCShop.Models
@model LoginViewModel
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <div class="sf-card p-4 p-md-5 mx-auto" style="max-width: 440px;">
        <div class="text-center mb-4">
            <img src="/Content/images/logo.png" alt="PCShop" class="mx-auto mb-3 d-block" style="height: 40px; width: auto; object-fit: contain;" />
            <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 4px;">Đăng nhập tài khoản</h1>
            <p style="font-size: 13.5px; color: var(--sf-muted); margin: 0;">Theo dõi đơn hàng và quản lý thông tin mua sắm tại PCShop.</p>
        </div>

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 px-3 mb-3", @style = "border-radius: 10px; font-size: 13px;" })

            <div class="form-group">
                <label for="UserName" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Tên đăng nhập <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.UserName, new { @class = "sf-comment-input", @placeholder = "Nhập tên đăng nhập", @autocomplete = "username" })
                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small d-block mt-1" })
            </div>

            <div class="form-group">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <label for="Password" class="mb-0" style="font-size: 13px; font-weight: 500;">Mật khẩu <span class="text-danger">*</span></label>
                    <a href="/Account/ForgotPassword" style="font-size: 12.5px; color: var(--sf-primary); text-decoration: none;">Quên mật khẩu?</a>
                </div>
                @Html.PasswordFor(m => m.Password, new { @class = "sf-comment-input", @placeholder = "Nhập mật khẩu", @autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small d-block mt-1" })
            </div>

            <div class="form-group mb-4">
                <label class="d-inline-flex align-items-center mb-0" style="gap: 8px; font-size: 13.5px; cursor: pointer;">
                    @Html.CheckBoxFor(m => m.RememberMe)
                    <span>Ghi nhớ đăng nhập</span>
                </label>
            </div>

            <button type="submit" class="sf-btn-primary w-100" style="min-height: 42px;">Đăng nhập</button>
        }

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid var(--sf-border); font-size: 13.5px; color: var(--sf-muted);">
            Chưa có tài khoản?
            <a href="/Account/Register" style="color: var(--sf-primary); font-weight: 600; text-decoration: none;">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
