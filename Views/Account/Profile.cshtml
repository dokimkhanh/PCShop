@model PCShop.Models.UserProfileViewModel
@{
    ViewBag.Title = "Thông tin tài khoản";
    var orders = Model.Orders != null ? Model.Orders.ToList() : new System.Collections.Generic.List<PCShop.Models.EF.Order>();
    var totalOrders = orders.Count;
    var paidOrders = orders.Count(o => o.paymentStatus == 1);
    var totalSpent = orders.Where(o => o.paymentStatus != 2).Sum(o => (long)o.totalAmount);
    var displayName = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : Model.UserName;
    var avatarInitial = !string.IsNullOrWhiteSpace(displayName) ? displayName.Trim().Substring(0, 1).ToUpper() : "U";
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <span class="current">Thông tin tài khoản</span>
    </nav>

    <div class="sf-card p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 16px;">
            <div class="d-flex align-items-center" style="gap: 14px;">
                <div class="d-inline-flex align-items-center justify-content-center" style="width: 56px; height: 56px; border-radius: 16px; background: var(--sf-primary-light); color: var(--sf-primary); font-size: 22px; font-weight: 700; flex-shrink: 0;">
                    @avatarInitial
                </div>
                <div>
                    <h1 style="font-size: 20px; font-weight: 700; margin: 0;">@displayName</h1>
                    <div style="font-size: 13px; color: var(--sf-muted); margin-top: 2px;">
                        @@@Model.UserName
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <span>&middot; @Model.Email</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap" style="gap: 12px;">
                <div class="px-3 py-2" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px; min-width: 112px;">
                    <div style="font-size: 11.5px; color: var(--sf-muted);">Tổng đơn hàng</div>
                    <div class="sf-tabular" style="font-size: 18px; font-weight: 700;">@totalOrders</div>
                </div>
                <div class="px-3 py-2" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px; min-width: 112px;">
                    <div style="font-size: 11.5px; color: var(--sf-muted);">Đã thanh toán</div>
                    <div class="sf-tabular" style="font-size: 18px; font-weight: 700; color: var(--sf-success);">@paidOrders</div>
                </div>
                <div class="px-3 py-2" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px; min-width: 148px;">
                    <div style="font-size: 11.5px; color: var(--sf-muted);">Tổng chi tiêu</div>
                    <div class="sf-tabular" style="font-size: 18px; font-weight: 700; color: var(--sf-primary);">@PCShop.Models.Common.CommonHelper.ConvertMoney(totalSpent) đ</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="sf-card p-4 h-100">
                <h2 style="font-size: 17px; font-weight: 700; margin-bottom: 16px;">Hồ sơ cá nhân</h2>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert alert-success py-2 px-3 mb-3" style="font-size: 13.5px; border-radius: 10px;">@TempData["ProfileSuccess"]</div>
                }

                @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                    <div class="form-group">
                        <label style="font-size: 13px; font-weight: 600;">Tên đăng nhập</label>
                        <input type="text" class="form-control" value="@Model.UserName" readonly style="border-radius: 10px; height: 42px; background: var(--sf-bg); border-color: var(--sf-border-strong);" />
                    </div>
                    <div class="form-group">
                        <label for="FullName" style="font-size: 13px; font-weight: 600;">Họ và tên</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", @placeholder = "Nhập họ và tên", @style = "border-radius: 10px; height: 42px; border-color: var(--sf-border-strong);" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="form-group">
                        <label for="Email" style="font-size: 13px; font-weight: 600;">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = "Nhập email", @style = "border-radius: 10px; height: 42px; border-color: var(--sf-border-strong);" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="form-group">
                        <label for="Phone" style="font-size: 13px; font-weight: 600;">Số điện thoại</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", @placeholder = "Nhập số điện thoại", @style = "border-radius: 10px; height: 42px; border-color: var(--sf-border-strong);" })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex flex-wrap align-items-center justify-content-between mt-4 pt-2" style="gap: 10px;">
                        <a href="/Manage/ChangePassword" class="sf-link-all" style="font-size: 13.5px;">
                            <i class="fa fa-lock" aria-hidden="true"></i>
                            <span>Đổi mật khẩu</span>
                        </a>
                        <button type="submit" class="sf-btn-primary px-4">Lưu thông tin</button>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="sf-card p-4 h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 style="font-size: 17px; font-weight: 700; margin: 0;">Lịch sử đơn hàng</h2>
                    <span style="font-size: 12.5px; color: var(--sf-muted);" class="sf-tabular">@totalOrders đơn hàng</span>
                </div>

                @if (orders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" style="font-size: 13.5px;">
                            <thead>
                                <tr style="color: var(--sf-muted); font-size: 12px; text-transform: uppercase;">
                                    <th style="border-top: 0;">Mã đơn</th>
                                    <th style="border-top: 0;">Ngày đặt</th>
                                    <th style="border-top: 0;" class="text-right">Tổng tiền</th>
                                    <th style="border-top: 0;" class="text-right">Trạng thái</th>
                                    <th style="border-top: 0; width: 92px;" class="text-right"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in orders)
                                {
                                    <tr>
                                        <td style="font-weight: 600; vertical-align: middle;">
                                            <button type="button" class="btn-link p-0 border-0 bg-transparent sf-open-order" data-id="@order.Id" style="font-weight: 600; color: var(--sf-primary); cursor: pointer;">
                                                #@order.code
                                            </button>
                                        </td>
                                        <td class="sf-tabular" style="color: var(--sf-muted); vertical-align: middle;">@order.createdDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-right sf-tabular" style="font-weight: 600; vertical-align: middle;">@PCShop.Models.Common.CommonHelper.ConvertMoney(order.totalAmount) đ</td>
                                        <td class="text-right" style="vertical-align: middle;">
                                            @if (order.paymentStatus == 0)
                                            {
                                                <span class="sf-status-pill sf-status-warning">Chưa thanh toán</span>
                                            }
                                            else if (order.paymentStatus == 1)
                                            {
                                                <span class="sf-status-pill sf-status-success">Đã thanh toán</span>
                                            }
                                            else
                                            {
                                                <span class="sf-status-pill sf-status-danger">Đã hủy</span>
                                            }
                                        </td>
                                        <td class="text-right" style="vertical-align: middle;">
                                            <button type="button" class="sf-btn-outline sf-open-order" data-id="@order.Id" style="min-height: 30px; padding: 0 10px; font-size: 12.5px;">
                                                Chi tiết
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="mb-3" style="font-size: 34px; color: #d4d4d8;"><i class="fa fa-shopping-bag" aria-hidden="true"></i></div>
                        <div style="font-weight: 600; margin-bottom: 4px;">Bạn chưa có đơn hàng nào</div>
                        <p style="font-size: 13.5px; color: var(--sf-muted); margin-bottom: 18px;">Đơn hàng sau khi đặt sẽ hiển thị trạng thái chi tiết tại đây.</p>
                        <a href="/san-pham" class="sf-btn-primary">Khám phá sản phẩm</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="sfOrderDetailModal" tabindex="-1" role="dialog" aria-labelledby="sfOrderDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content" style="border-radius: 16px; border: 1px solid var(--sf-border-strong); overflow: hidden;">
            <div class="modal-header align-items-center" style="border-bottom: 1px solid var(--sf-border); padding: 16px 22px;">
                <div class="d-flex flex-wrap align-items-center" style="gap: 10px;">
                    <h5 class="modal-title mb-0" id="sfOrderDetailTitle" style="font-size: 17px; font-weight: 700;">Chi tiết đơn hàng</h5>
                    <span id="sfOdStatusPill"></span>
                </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding: 20px 22px;">
                <div id="sfOdLoading" class="text-center py-5" style="color: var(--sf-muted); font-size: 13.5px;">
                    <i class="fa fa-spinner fa-spin mr-1" aria-hidden="true"></i> Đang tải chi tiết đơn hàng...
                </div>
                <div id="sfOdError" class="alert alert-danger mb-0" style="display: none; border-radius: 10px; font-size: 13.5px;"></div>
                <div id="sfOdContent" style="display: none;">
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="p-3 h-100" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px; font-size: 13px; line-height: 1.7;">
                                <div style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sf-muted); margin-bottom: 6px;">Thông tin giao hàng</div>
                                <div id="sfOdName" style="font-weight: 600; color: var(--sf-fg);"></div>
                                <div id="sfOdPhone" style="color: var(--sf-fg);"></div>
                                <div id="sfOdEmail" style="color: var(--sf-muted);"></div>
                                <div id="sfOdAddress" style="color: var(--sf-muted); margin-top: 2px;"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 h-100" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px; font-size: 13px; line-height: 1.7;">
                                <div style="font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sf-muted); margin-bottom: 6px;">Thông tin đơn hàng</div>
                                <div>Thời gian đặt: <strong id="sfOdDate" class="sf-tabular" style="color: var(--sf-fg);"></strong></div>
                                <div>Thanh toán: <strong id="sfOdPayType" style="color: var(--sf-fg);"></strong></div>
                                <div>Số lượng: <strong id="sfOdQty" class="sf-tabular" style="color: var(--sf-fg);"></strong></div>
                            </div>
                        </div>
                    </div>

                    <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--sf-muted); padding-bottom: 8px; border-bottom: 1px solid var(--sf-border);">
                        Sản phẩm đã đặt
                    </div>
                    <div id="sfOdItems" class="mb-3"></div>

                    <div class="pt-3" style="border-top: 1px solid var(--sf-border-strong);">
                        <div class="d-flex justify-content-between mb-1" style="font-size: 13.5px;">
                            <span style="color: var(--sf-muted);">Phí vận chuyển</span>
                            <span style="color: var(--sf-success); font-weight: 600;">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-baseline mt-2">
                            <span style="font-size: 15px; font-weight: 700;">Tổng thanh toán</span>
                            <span id="sfOdTotal" class="sf-tabular" style="font-size: 20px; font-weight: 700; color: var(--sf-primary);"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--sf-border); padding: 12px 22px;">
                <button type="button" class="sf-btn-outline" data-dismiss="modal" style="min-height: 36px; padding: 0 16px;">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            var fallbackImg = '@Url.Content("~/Content/assets/images/product_1.png")';

            function renderStatusPill(status, text) {
                var cls = status === 1 ? 'sf-status-success' : (status === 2 ? 'sf-status-danger' : 'sf-status-warning');
                return $('<span>').addClass('sf-status-pill ' + cls).text(text);
            }

            $(document).on('click', '.sf-open-order', function () {
                var id = $(this).data('id');
                $('#sfOrderDetailTitle').text('Chi tiết đơn hàng');
                $('#sfOdStatusPill').empty();
                $('#sfOdError').hide().text('');
                $('#sfOdContent').hide();
                $('#sfOdLoading').show();
                $('#sfOrderDetailModal').modal('show');

                $.getJSON('/Account/OrderDetail', { id: id })
                    .done(function (res) {
                        $('#sfOdLoading').hide();
                        if (!res || !res.success || !res.order) {
                            $('#sfOdError').text((res && res.message) || 'Không thể tải chi tiết đơn hàng.').show();
                            return;
                        }
                        var o = res.order;
                        $('#sfOrderDetailTitle').text('Đơn hàng #' + o.code);
                        $('#sfOdStatusPill').empty().append(renderStatusPill(o.paymentStatus, o.paymentStatusText));
                        $('#sfOdName').text(o.customerName);
                        $('#sfOdPhone').text(o.phone);
                        $('#sfOdEmail').text(o.email);
                        $('#sfOdAddress').text(o.address);
                        $('#sfOdDate').text(o.createdDate);
                        $('#sfOdPayType').text(o.paymentTypeText);
                        $('#sfOdQty').text(o.totalQuantity + ' sản phẩm');
                        $('#sfOdTotal').text(o.totalAmountText);

                        var $list = $('#sfOdItems').empty();
                        if (o.items && o.items.length > 0) {
                            $.each(o.items, function (_, item) {
                                var $row = $('<div>').addClass('d-flex align-items-center py-3').css({
                                    gap: '12px',
                                    borderBottom: '1px solid var(--sf-border)'
                                });
                                var $img = $('<img>')
                                    .attr('src', item.image || fallbackImg)
                                    .attr('alt', item.title)
                                    .on('error', function () { $(this).off('error').attr('src', fallbackImg); })
                                    .css({
                                        width: '54px',
                                        height: '54px',
                                        objectFit: 'contain',
                                        padding: '4px',
                                        background: '#fafafa',
                                        border: '1px solid var(--sf-border-strong)',
                                        borderRadius: '10px',
                                        flexShrink: 0
                                    });
                                var $info = $('<div>').addClass('flex-grow-1').css('min-width', 0);
                                var $titleEl = item.url
                                    ? $('<a>').attr('href', item.url).text(item.title).css({
                                        fontSize: '13.5px',
                                        fontWeight: 600,
                                        color: 'var(--sf-fg)',
                                        textDecoration: 'none',
                                        display: 'block'
                                    })
                                    : $('<div>').text(item.title).css({ fontSize: '13.5px', fontWeight: 600, color: 'var(--sf-fg)' });
                                var $sub = $('<div>').addClass('sf-tabular').text('SL: ' + item.quantity + ' × ' + item.priceText).css({
                                    fontSize: '12.5px',
                                    color: 'var(--sf-muted)',
                                    marginTop: '2px'
                                });
                                $info.append($titleEl, $sub);

                                var $line = $('<div>').addClass('sf-tabular text-right').text(item.lineTotalText).css({
                                    fontSize: '13.5px',
                                    fontWeight: 600,
                                    whiteSpace: 'nowrap'
                                });
                                $row.append($img, $info, $line);
                                $list.append($row);
                            });
                        } else {
                            $list.append($('<div>').addClass('py-3 text-center').css({ color: 'var(--sf-muted)', fontSize: '13px' }).text('Không có chi tiết sản phẩm.'));
                        }

                        $('#sfOdContent').show();
                    })
                    .fail(function () {
                        $('#sfOdLoading').hide();
                        $('#sfOdError').text('Lỗi kết nối khi tải chi tiết đơn hàng.').show();
                    });
            });
        });
    </script>
}
