@model IEnumerable<PCShop.Models.EF.CartItems>
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
    var items = Model != null ? Model.ToList() : new System.Collections.Generic.List<PCShop.Models.EF.CartItems>();
    var totalQty = items.Sum(x => x.quantity);
    var totalAmount = items.Sum(x => x.totalPrice);
    var enabledMethods = ViewBag.PaymentMethods as System.Collections.Generic.List<PCShop.Models.Common.PaymentMethodInfo>
        ?? PCShop.Models.Common.PaymentConfigHelper.GetAllMethods().Where(x => x.IsEnabled).ToList();
    var hasPaymentMethods = enabledMethods.Any();
}

<style>
    label.error {
        color: #b91c1c;
        font-size: 12px;
        margin-top: 4px;
        display: block;
    }

    .sf-payment-option {
        border: 1px solid var(--sf-border-strong);
        background: var(--sf-surface);
        border-radius: 12px;
        cursor: pointer;
        transition: border-color 140ms ease, background-color 140ms ease;
    }

    .sf-payment-option:hover {
        border-color: var(--sf-primary);
    }

    .sf-payment-option.is-active {
        border: 1.5px solid var(--sf-primary);
        background: var(--sf-primary-light);
    }
</style>

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/Cart">Giỏ hàng</a>
        <span class="sep">/</span>
        <span class="current">Thanh toán</span>
    </nav>

    <div class="sf-section-head mb-4">
        <div>
            <h1 class="sf-section-title" style="font-size: 24px;">Thanh toán đơn hàng</h1>
            <div class="sf-section-sub">Điền thông tin nhận hàng bên dưới để hoàn tất đặt mua.</div>
        </div>
    </div>

    @if (items.Any())
    {
        <div class="row">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <div class="sf-card p-4">
                    @using (Ajax.BeginForm("CheckOut", "Cart", new AjaxOptions
                    {
                        HttpMethod = "POST",
                        UpdateTargetId = "ShowCount",
                        OnSuccess = "onSuc",
                        OnFailure = "onFai",
                        OnBegin = "onBegin"
                    }, new { @id = "paymentForm" }))
                    {
                        @Html.AntiForgeryToken()
                        foreach (var cartItem in items)
                        {
                            <input type="hidden" name="items" value="@(cartItem.Id):@(cartItem.quantity)" />
                        }

                        <h2 style="font-size: 17px; font-weight: 700; margin-bottom: 16px;">Thông tin giao hàng</h2>

                        <div class="row">
                            <div class="col-md-6 form-group">
                                <label for="customerName" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Họ và tên <span class="text-danger">*</span></label>
                                <input class="sf-comment-input" type="text" id="customerName" name="customerName" value="@(ViewBag.UserFullName as string ?? "")" placeholder="Nguyễn Văn A" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label for="phone" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Số điện thoại <span class="text-danger">*</span></label>
                                <input class="sf-comment-input" type="tel" id="phone" name="phone" value="@(ViewBag.UserPhone as string ?? "")" placeholder="09xx xxx xxx" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="address" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                            <input class="sf-comment-input" type="text" id="address" name="address" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" />
                        </div>

                        <div class="form-group mb-4">
                            <label for="txtEmail" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Email nhận hoá đơn điện tử <span class="text-danger">*</span></label>
                            <input class="sf-comment-input" type="email" id="txtEmail" name="email" value="@(ViewBag.UserEmail as string ?? "")" placeholder="ban@email.com" />
                        </div>

                        <div class="pt-3 mb-4" id="load_payment_form" style="border-top: 1px solid var(--sf-border);">
                            <h2 style="font-size: 17px; font-weight: 700; margin-bottom: 12px;">Phương thức thanh toán</h2>

                            @if (hasPaymentMethods)
                            {
                                <div class="d-flex flex-column" style="gap: 10px;">
                                    @for (int idx = 0; idx < enabledMethods.Count; idx++)
                                    {
                                        var method = enabledMethods[idx];
                                        var isFirst = idx == 0;
                                        <label class="sf-payment-option p-3 mb-0 d-flex align-items-start @(isFirst ? "is-active" : "")" style="gap: 10px;">
                                            <input type="radio" name="paymentType" value="@method.Code" @(isFirst ? "checked" : "") style="margin-top: 4px;" />
                                            <div>
                                                <div style="font-weight: 600; color: var(--sf-fg);">@method.Title</div>
                                                <div style="font-size: 12.5px; color: var(--sf-muted); margin-top: 2px;">@method.Description</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; border-radius: 12px; padding: 14px 16px; font-size: 13.5px;">
                                    <i class="fa fa-exclamation-circle mr-1" aria-hidden="true"></i>
                                    Hiện tại cửa hàng đang tạm tắt các phương thức thanh toán. Vui lòng liên hệ bộ phận hỗ trợ để được đặt hàng.
                                </div>
                            }
                        </div>

                        <div id="form_btnPay" class="mb-2" style="font-size: 13.5px; color: var(--sf-muted);"></div>
                        <button type="submit" id="btnPayment" class="sf-btn-primary w-100" style="min-height: 44px;@(hasPaymentMethods ? "" : " opacity: 0.55; cursor: not-allowed;")" @(hasPaymentMethods ? "" : "disabled")>
                            <span>Xác nhận đặt hàng</span>
                            <i class="fa fa-check" aria-hidden="true"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="sf-card p-4" style="position: sticky; top: 124px;">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 style="font-size: 17px; font-weight: 700; margin: 0;">Đơn hàng của bạn</h2>
                        <span class="sf-tabular" style="font-size: 13px; color: var(--sf-muted);">@totalQty sản phẩm</span>
                    </div>

                    <div class="mb-3" style="border-top: 1px solid var(--sf-border);">
                        @foreach (var item in items)
                        {
                            var imgSrc = string.IsNullOrWhiteSpace(item.productImg) ? fallbackImg : item.productImg;
                            <div class="d-flex align-items-center py-3" style="gap: 12px; border-bottom: 1px solid var(--sf-border);">
                                <img src="@imgSrc" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.productName" style="width: 56px; height: 56px; object-fit: contain; padding: 4px; background: #fafafa; border: 1px solid var(--sf-border-strong); border-radius: 10px; flex-shrink: 0;" />
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <a href="/san-pham/@item.Alias-p@(item.Id)" style="font-size: 13.5px; font-weight: 600; color: var(--sf-fg); text-decoration: none; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@item.productName">@item.productName</a>
                                    <div class="sf-tabular" style="font-size: 12.5px; color: var(--sf-muted);">
                                        @PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ &times; @item.quantity
                                    </div>
                                </div>
                                <div class="sf-tabular text-right" style="font-size: 13.5px; font-weight: 600; white-space: nowrap;">
                                    @PCShop.Models.Common.CommonHelper.ConvertMoney(item.totalPrice) đ
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2" style="font-size: 13.5px;">
                        <span style="color: var(--sf-muted);">Tạm tính</span>
                        <span class="sf-tabular">@PCShop.Models.Common.CommonHelper.ConvertMoney(totalAmount) đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-3" style="font-size: 13.5px; border-bottom: 1px solid var(--sf-border);">
                        <span style="color: var(--sf-muted);">Phí vận chuyển</span>
                        <span style="color: var(--sf-success); font-weight: 600;">Miễn phí</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <span style="font-size: 15px; font-weight: 600;">Tổng thanh toán</span>
                        <span class="sf-tabular" style="font-size: 20px; font-weight: 700; color: var(--sf-primary);">@PCShop.Models.Common.CommonHelper.ConvertMoney(totalAmount) đ</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="sf-card p-5 text-center">
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 6px;">Giỏ hàng của bạn đang trống</h2>
            <p style="color: var(--sf-muted); margin-bottom: 18px;">Hãy chọn sản phẩm trước khi tiến hành thanh toán.</p>
            <a href="/san-pham" class="sf-btn-primary">Khám phá sản phẩm</a>
        </div>
    }
</div>

@section scripts{
    <script>
        function onBegin() {
            $('#form_btnPay').text('Đang xử lý đơn hàng, vui lòng đợi...');
            $('#btnPayment').prop('disabled', true);
        }
        function onFai() {
            $('#form_btnPay').text('');
            $('#btnPayment').prop('disabled', false);
            if (window.toastr) {
                toastr.error('Đặt hàng thất bại. Vui lòng thử lại.');
            } else {
                alert('Đặt hàng thất bại. Vui lòng thử lại.');
            }
        }
        function onSuc(rs) {
            if (rs.Success) {
                if (rs.Code == 2) {
                    window.location.href = '/Cart/CheckOutSuccess';
                } else if (rs.Url) {
                    location.href = rs.Url;
                } else {
                    $('#form_btnPay').text('');
                    $('#btnPayment').prop('disabled', false);
                    if (window.toastr) {
                        toastr.error('Không tạo được liên kết thanh toán. Vui lòng thử lại.');
                    }
                }
            } else {
                $('#form_btnPay').text('');
                $('#btnPayment').prop('disabled', false);
                if (window.toastr) {
                    toastr.error(rs.msg || 'Đặt hàng thất bại');
                } else {
                    alert(rs.msg || 'Đặt hàng thất bại');
                }
            }
        }
        $(document).ready(function () {
            $('#load_payment_form').on('change', 'input[name="paymentType"]', function () {
                $('#load_payment_form .sf-payment-option').removeClass('is-active');
                $(this).closest('.sf-payment-option').addClass('is-active');
            });

            $('#paymentForm').validate({
                rules: {
                    'customerName': { required: true },
                    'phone': { required: true },
                    'address': { required: true },
                    'email': { required: true, email: true }
                },
                messages: {
                    'customerName': 'Vui lòng nhập họ và tên',
                    'phone': 'Vui lòng nhập số điện thoại liên hệ',
                    'address': 'Vui lòng nhập địa chỉ giao hàng',
                    'email': {
                        required: 'Vui lòng nhập Email để nhận hoá đơn điện tử',
                        email: 'Địa chỉ email không hợp lệ'
                    }
                }
            });
        });
    </script>
}
