@model PCShop.Models.EF.Order
@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/Cart">Giỏ hàng</a>
        <span class="sep">/</span>
        <span class="current">Đặt hàng thành công</span>
    </nav>

    <div class="sf-card p-4 p-md-5 text-center mx-auto" style="max-width: 560px;">
        <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 16px; background: var(--sf-success-bg); color: var(--sf-success); font-size: 28px;">
            <i class="fa fa-check" aria-hidden="true"></i>
        </div>

        <h1 style="font-size: 22px; font-weight: 700; margin-bottom: 8px;">Đặt hàng thành công</h1>
        <p style="font-size: 14px; color: var(--sf-muted); margin-bottom: 20px;">
            Cảm ơn bạn đã tin tưởng lựa chọn PCShop. Nhân viên của chúng tôi sẽ liên hệ xác nhận và giao hàng đến bạn trong thời gian sớm nhất.
        </p>

        @if (Model != null && !string.IsNullOrWhiteSpace(Model.code))
        {
            <div class="p-3 mb-4" style="background: var(--sf-bg); border: 1px solid var(--sf-border); border-radius: 12px; font-size: 13.5px;">
                Mã đơn hàng của bạn: <strong class="sf-tabular">@Model.code</strong>
            </div>
        }

        <div class="d-flex flex-wrap justify-content-center" style="gap: 10px;">
            <a href="/san-pham" class="sf-btn-primary px-4">Tiếp tục mua sắm</a>
            @if (Request.IsAuthenticated)
            {
                <a href="/Account/Profile" class="sf-btn-outline px-4">Xem lịch sử đơn hàng</a>
            }
            else
            {
                <a href="/" class="sf-btn-outline px-4">Về trang chủ</a>
            }
        </div>
    </div>
</div>
