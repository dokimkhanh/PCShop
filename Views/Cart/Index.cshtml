@model IEnumerable<PCShop.Models.EF.CartItems>
@{
    ViewBag.Title = "Giỏ hàng";
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
    var items = Model != null ? Model.ToList() : new System.Collections.Generic.List<PCShop.Models.EF.CartItems>();
    var totalQty = items.Sum(x => x.quantity);
    var totalAmount = items.Sum(x => x.totalPrice);
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <span class="current">Giỏ hàng</span>
    </nav>

    <div class="sf-section-head mb-4">
        <div>
            <h1 class="sf-section-title" style="font-size: 24px;">Giỏ hàng của bạn</h1>
            @if (items.Any())
            {
                <div class="sf-section-sub">Hiện có <strong class="sf-tabular">@totalQty</strong> sản phẩm sẵn sàng đặt mua.</div>
            }
        </div>
        @if (items.Any())
        {
            <a href="#" class="sf-btn-outline btnClear" style="color: var(--sf-danger) !important;">
                <i class="fa fa-trash-o" aria-hidden="true"></i>
                <span>Làm mới giỏ hàng</span>
            </a>
        }
    </div>

    @if (items.Any())
    {
        <div class="row">
            <div class="col-lg-8 mb-4 mb-lg-0">
                <div class="sf-card">
                    @foreach (var item in items)
                    {
                        var imgSrc = string.IsNullOrWhiteSpace(item.productImg) ? fallbackImg : item.productImg;
                        <div class="sf-cart-row" id="row_@item.Id">
                            <a href="/san-pham/@item.Alias-p@(item.Id)" class="flex-shrink-0">
                                <img src="@imgSrc" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.productName" class="sf-cart-thumb" />
                            </a>

                            <div class="flex-grow-1" style="min-width: 180px;">
                                <a href="/san-pham/@item.Alias-p@(item.Id)" style="font-weight: 600; color: var(--sf-fg); text-decoration: none; display: block; margin-bottom: 4px;">@item.productName</a>
                                <div style="font-size: 13px; color: var(--sf-muted);">
                                    Đơn giá: <strong class="sf-tabular" style="color: var(--sf-fg);">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.price) đ</strong>
                                </div>
                            </div>

                            <div class="sf-qty-stepper">
                                <button type="button" class="sf-qty-dec" data-target="#quantity_value_@item.Id" aria-label="Giảm số lượng" tabindex="-1" @(item.quantity <= 1 ? "disabled" : "")>
                                    <span class="sf-qty-hit"><i class="fa fa-minus" aria-hidden="true"></i></span>
                                </button>
                                <input type="text" inputmode="numeric" role="spinbutton" autocomplete="off" maxlength="4" aria-valuemin="1" aria-valuenow="@item.quantity" id="quantity_value_@item.Id" data-id="@item.Id" data-prev="@item.quantity" class="inputUpdate sf-tabular" value="@item.quantity" aria-label="Số lượng" />
                                <button type="button" class="sf-qty-inc" data-target="#quantity_value_@item.Id" aria-label="Tăng số lượng" tabindex="-1">
                                    <span class="sf-qty-hit"><i class="fa fa-plus" aria-hidden="true"></i></span>
                                </button>
                            </div>

                            <div class="text-right" style="min-width: 118px;">
                                <div style="font-size: 12px; color: var(--sf-muted);">Thành tiền</div>
                                <div class="sf-tabular" style="font-size: 15px; font-weight: 700; color: var(--sf-primary);">@PCShop.Models.Common.CommonHelper.ConvertMoney(item.totalPrice) đ</div>
                            </div>

                            <a href="#" data-id="@item.Id" class="sf-btn-outline btnDelete" title="Xóa khỏi giỏ hàng" aria-label="Xóa sản phẩm" style="min-height: 36px; width: 36px; padding: 0; color: var(--sf-muted) !important;">
                                <i class="fa fa-trash-o" aria-hidden="true"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sf-card p-4" style="position: sticky; top: 124px;">
                    <h2 style="font-size: 17px; font-weight: 700; margin-bottom: 16px;">Tóm tắt đơn hàng</h2>

                    <div class="d-flex justify-content-between mb-2" style="font-size: 13.5px;">
                        <span style="color: var(--sf-muted);">Tạm tính (@totalQty sản phẩm)</span>
                        <span class="sf-tabular font-weight-semibold">@PCShop.Models.Common.CommonHelper.ConvertMoney(totalAmount) đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 pb-3" style="font-size: 13.5px; border-bottom: 1px solid var(--sf-border);">
                        <span style="color: var(--sf-muted);">Phí vận chuyển</span>
                        <span style="color: var(--sf-success); font-weight: 600;">Miễn phí</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span style="font-size: 15px; font-weight: 600;">Tổng cộng</span>
                        <span class="sf-tabular" style="font-size: 20px; font-weight: 700; color: var(--sf-primary);">@PCShop.Models.Common.CommonHelper.ConvertMoney(totalAmount) đ</span>
                    </div>

                    <a href="/thanh-toan" class="sf-btn-primary w-100 mb-2" style="min-height: 44px;">
                        <span>Tiến hành đặt hàng</span>
                        <i class="fa fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a href="/san-pham" class="sf-btn-outline w-100">
                        <i class="fa fa-angle-left" aria-hidden="true"></i>
                        <span>Tiếp tục mua sắm</span>
                    </a>

                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--sf-border); font-size: 12.5px; color: var(--sf-muted);">
                        <i class="fa fa-shield mr-1" style="color: var(--sf-success);" aria-hidden="true"></i>
                        Thanh toán khi nhận hàng (COD), kiểm tra sản phẩm trước khi thanh toán.
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="sf-card p-5 text-center">
            <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 16px; background: var(--sf-primary-light); color: var(--sf-primary); font-size: 26px;">
                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
            </div>
            <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 6px;">Giỏ hàng của bạn đang trống</h2>
            <p style="color: var(--sf-muted); max-width: 420px; margin: 0 auto 20px;">Hãy khám phá các dòng PC Gaming, Laptop và linh kiện chính hãng đang có ưu đãi tại PCShop.</p>
            <a href="/san-pham" class="sf-btn-primary">
                <span>Khám phá sản phẩm</span>
                <i class="fa fa-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
    }
</div>

@section scripts{
    <script>
        $(function () {
            $('.sf-qty-dec, .sf-qty-inc').on('mousedown', function (e) {
                e.preventDefault();
            });

            $('.sf-qty-dec').on('click', function () {
                var $input = $($(this).data('target'));
                var current = parseInt($input.val(), 10) || parseInt($input.data('prev'), 10) || 1;
                if (current > 1) {
                    $input.val(current - 1).trigger('change');
                }
            });

            $('.sf-qty-inc').on('click', function () {
                var $input = $($(this).data('target'));
                var current = parseInt($input.val(), 10) || parseInt($input.data('prev'), 10) || 1;
                $input.val(current + 1).trigger('change');
            });

            $('.sf-qty-stepper .inputUpdate').on('input', function () {
                this.value = this.value.replace(/[^\d]/g, '');
            }).on('keydown', function (e) {
                var current = parseInt($(this).val(), 10) || parseInt($(this).data('prev'), 10) || 1;
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    $(this).val(current + 1).trigger('change');
                } else if (e.key === 'ArrowDown' && current > 1) {
                    e.preventDefault();
                    $(this).val(current - 1).trigger('change');
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    $(this).trigger('blur');
                }
            }).on('blur', function () {
                var val = parseInt($(this).val(), 10);
                if (isNaN(val) || val < 1) {
                    $(this).val($(this).data('prev') || 1);
                }
            });
        });
    </script>
}
