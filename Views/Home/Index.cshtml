@using PCShop.Models.Common
@{
    ViewBag.Title = "Trang chủ";
    var openHours = SettingsHelper.GetValue("SettingOpenHours");
    if (string.IsNullOrWhiteSpace(openHours)) { openHours = "08:30 - 21:00 mỗi ngày"; }
}

<section class="pt-4 pb-2">
    <div class="container">
        <a href="/san-pham" class="sf-hero-banner" style="background-image:url('@Url.Content("~/Content/assets/images/slider_1.jpg")')" aria-label="Xem danh sách sản phẩm PCShop"></a>
    </div>
</section>

<section class="sf-section" style="padding-top: 24px;">
    <div class="container">
        <div class="sf-benefit-grid">
            <div class="sf-benefit-item">
                <div class="sf-benefit-icon"><i class="fa fa-truck" aria-hidden="true"></i></div>
                <div>
                    <h6>Giao hàng toàn quốc</h6>
                    <p>Đóng gói chống sốc an toàn</p>
                </div>
            </div>
            <div class="sf-benefit-item">
                <div class="sf-benefit-icon"><i class="fa fa-money" aria-hidden="true"></i></div>
                <div>
                    <h6>Thanh toán khi nhận hàng</h6>
                    <p>Kiểm tra máy trước khi trả tiền</p>
                </div>
            </div>
            <div class="sf-benefit-item">
                <div class="sf-benefit-icon"><i class="fa fa-shield" aria-hidden="true"></i></div>
                <div>
                    <h6>Bảo hành chính hãng</h6>
                    <p>Đổi mới lỗi nhà sản xuất 15 ngày</p>
                </div>
            </div>
            <div class="sf-benefit-item">
                <div class="sf-benefit-icon"><i class="fa fa-clock-o" aria-hidden="true"></i></div>
                <div>
                    <h6>Hỗ trợ xuyên suốt</h6>
                    <p>@openHours</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="sf-section" style="padding-top: 8px;">
    <div class="container">
        @Html.Action("MenuArrivals", "Menu")
    </div>
</section>

<section class="sf-section" style="padding-top: 8px;">
    <div class="container">
        @Html.Action("ItemProductSale", "Product")
    </div>
</section>

<section class="sf-section" style="padding-top: 8px; padding-bottom: 52px;">
    <div class="container">
        <div class="sf-section-head">
            <div>
                <h2 class="sf-section-title">Tin tức &amp; Tư vấn công nghệ</h2>
                <div class="sf-section-sub">Cập nhật đánh giá linh kiện, cấu hình PC và ưu đãi mới nhất</div>
            </div>
            <a href="/tin-tuc" class="sf-link-all">Xem tất cả tin tức <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="sf-news-grid">
            @Html.Action("Partial_News", "News")
        </div>
    </div>
</section>
