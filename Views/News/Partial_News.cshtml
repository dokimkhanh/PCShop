@model IEnumerable<PCShop.Models.EF.News>
@{
    var fallbackImg = Url.Content("~/Content/assets/images/product_1.png");
}
@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        var imgSrc = !string.IsNullOrWhiteSpace(item.image) ? item.image : fallbackImg;
        <article class="sf-news-card">
            <a href="/tin-tuc/@item.alias-n@(item.id)" class="sf-news-thumb">
                <img src="@imgSrc" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@item.title" />
            </a>
            <div class="sf-news-body">
                <div class="sf-news-meta">
                    <i class="fa fa-calendar-o mr-1" aria-hidden="true"></i>@item.createdDate.ToString("dd/MM/yyyy")
                    <span class="mx-1">·</span>
                    @(string.IsNullOrWhiteSpace(item.createdBy) ? "PCShop" : item.createdBy)
                </div>
                <h3 class="sf-news-title">
                    <a href="/tin-tuc/@item.alias-n@(item.id)">@item.title</a>
                </h3>
                @if (!string.IsNullOrWhiteSpace(item.description))
                {
                    <p class="sf-news-desc">@item.description</p>
                }
                <a href="/tin-tuc/@item.alias-n@(item.id)" class="sf-link-all mt-auto" style="font-size: 13px;">Đọc tiếp <i class="fa fa-angle-right" aria-hidden="true"></i></a>
            </div>
        </article>
    }
}
else
{
    <div class="sf-card p-4 text-center" style="grid-column: 1 / -1; color: var(--sf-muted);">
        Chưa có bài viết nào được xuất bản.
    </div>
}
