@model PagedList.PagedList<PCShop.Models.EF.News>
@using PagedList;
@using PagedList.Mvc;
@{
    ViewBag.Title = "Tin tức";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var fallbackImg = Url.Content("~/Content/assets/images/blog_1.jpg");
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <span class="current">Tin tức</span>
    </nav>

    <div class="sf-section-head mb-4">
        <div>
            <h1 class="sf-section-title" style="font-size: 24px;">Tin tức công nghệ</h1>
            <div class="sf-section-sub">Đánh giá linh kiện, mẹo tối ưu hiệu năng PC và thông tin ưu đãi mới nhất từ PCShop.</div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="sf-news-grid">
            @foreach (var item in Model)
            {
                var imgSrc = string.IsNullOrWhiteSpace(item.image) ? fallbackImg : item.image;
                var titleText = string.IsNullOrWhiteSpace(item.title) ? "Bài viết công nghệ" : item.title;
                var descText = item.description ?? "";

                <article class="sf-news-card">
                    <a href="/tin-tuc/@item.alias-n@(item.id)" class="sf-news-thumb">
                        <img src="@imgSrc" onerror="this.onerror=null;this.src='@fallbackImg';" alt="@titleText" />
                    </a>
                    <div class="sf-news-body">
                        <div class="sf-news-meta">
                            <i class="fa fa-calendar-o mr-1" aria-hidden="true"></i>
                            @item.createdDate.ToString("dd/MM/yyyy")
                        </div>
                        <h2 class="sf-news-title">
                            <a href="/tin-tuc/@item.alias-n@(item.id)" title="@titleText">@titleText</a>
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(descText))
                        {
                            <p class="sf-news-desc">@descText</p>
                        }
                        <a href="/tin-tuc/@item.alias-n@(item.id)" class="sf-link-all mt-auto" style="font-size: 13px;">
                            <span>Đọc bài viết</span>
                            <i class="fa fa-angle-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            }
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between mt-4 pt-3" style="gap: 12px; border-top: 1px solid var(--sf-border);">
            <div style="font-size: 13px; color: var(--sf-muted);">
                Hiển thị <strong class="sf-tabular">@Model.FirstItemOnPage - @Model.LastItemOnPage</strong> trong tổng số <strong class="sf-tabular">@Model.TotalItemCount</strong> bài viết
            </div>
            <div class="sf-pagination-wrap">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
            </div>
        </div>
    }
    else
    {
        <div class="sf-card p-5 text-center">
            <div class="mb-3" style="font-size: 36px; color: #d4d4d8;"><i class="fa fa-newspaper-o" aria-hidden="true"></i></div>
            <h3 style="font-size: 17px; font-weight: 600; margin-bottom: 6px;">Chưa có bài viết nào</h3>
            <p style="color: var(--sf-muted); margin-bottom: 18px;">Các bài viết tin tức và hướng dẫn công nghệ sẽ sớm được cập nhật tại đây.</p>
            <a href="/" class="sf-btn-primary">Quay về trang chủ</a>
        </div>
    }
</div>
