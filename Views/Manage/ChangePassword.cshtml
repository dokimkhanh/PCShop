@model PCShop.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container sf-page-wrap">
    <nav class="sf-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Trang chủ</a>
        <span class="sep">/</span>
        <a href="/Account/Profile">Thông tin tài khoản</a>
        <span class="sep">/</span>
        <span class="current">Đổi mật khẩu</span>
    </nav>

    <div class="sf-card p-4 p-md-5 mx-auto" style="max-width: 480px;">
        <h1 style="font-size: 20px; font-weight: 700; margin-bottom: 4px;">Đổi mật khẩu</h1>
        <p style="font-size: 13.5px; color: var(--sf-muted); margin-bottom: 20px;">Đặt mật khẩu mạnh để bảo vệ tài khoản PCShop của bạn.</p>

        @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger small mb-3" })

            <div class="form-group">
                <label for="OldPassword" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                @Html.PasswordFor(m => m.OldPassword, new { @class = "sf-comment-input", @placeholder = "Nhập mật khẩu hiện tại", @autocomplete = "current-password" })
            </div>

            <div class="form-group">
                <label for="NewPassword" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Mật khẩu mới <span class="text-danger">*</span></label>
                @Html.PasswordFor(m => m.NewPassword, new { @class = "sf-comment-input", @placeholder = "Nhập mật khẩu mới", @autocomplete = "new-password" })
            </div>

            <div class="form-group mb-4">
                <label for="ConfirmPassword" style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "sf-comment-input", @placeholder = "Nhập lại mật khẩu mới", @autocomplete = "new-password" })
            </div>

            <div class="d-flex flex-wrap align-items-center justify-content-between" style="gap: 10px;">
                <a href="/Account/Profile" class="sf-btn-outline">Quay lại hồ sơ</a>
                <button type="submit" class="sf-btn-primary px-4">Cập nhật mật khẩu</button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
