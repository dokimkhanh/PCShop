@model IEnumerable<PCShop.Models.EF.Category>
@{
    int? activeCategoryId = ViewBag.CategoryID as int?;
}
<ul class="sf-cat-list">
    <li class="@(activeCategoryId == null ? "active" : "")">
        <a href="/san-pham">
            <span>Tất cả sản phẩm</span>
            <i class="fa fa-angle-right" aria-hidden="true"></i>
        </a>
    </li>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            var isActive = activeCategoryId.HasValue && activeCategoryId.Value == item.id;
            <li class="@(isActive ? "active" : "")">
                <a href="/danh-muc/@item.alias/@(item.id)">
                    <span>@item.title</span>
                    <i class="fa fa-angle-right" aria-hidden="true"></i>
                </a>
            </li>
        }
    }
</ul>
