@model IEnumerable<PCShop.Models.Common.CategoryMenuNode>

<div class="sf-section-head">
    <div>
        <h2 class="sf-section-title">Sản phẩm nổi bật</h2>
        <div class="sf-section-sub">Lọc nhanh theo từng dòng sản phẩm của PCShop</div>
    </div>
    <a href="/san-pham" class="sf-link-all">Xem toàn bộ sản phẩm <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
</div>

@if (Model != null && Model.Any())
{
    <div class="sf-filter-pills mb-4" id="homeCatFilter">
        <button type="button" class="sf-pill-btn active" data-cat-filter="all">Tất cả</button>
        @foreach (var item in Model)
        {
            <button type="button" class="sf-pill-btn" data-cat-filter="@item.Alias">@item.Title</button>
        }
    </div>
}

<div class="sf-product-grid" id="homeProductGrid">
    @Html.Action("ItemByCategory", "Product")
</div>

<script>
    $(function () {
        $('#homeCatFilter').on('click', '.sf-pill-btn', function () {
            var selected = $(this).data('cat-filter');
            $('#homeCatFilter .sf-pill-btn').removeClass('active');
            $(this).addClass('active');

            var shown = 0;
            $('#homeProductGrid .sf-product-col').each(function () {
                var cat = $(this).data('cat');
                var rootCat = $(this).data('root-cat');
                var match = (selected === 'all' || cat === selected || rootCat === selected);
                if (match && (selected !== 'all' || shown < 12)) {
                    $(this).show();
                    shown++;
                } else {
                    $(this).hide();
                }
            });
        });

        $('#homeCatFilter .sf-pill-btn.active').trigger('click');
    });
</script>
